<mxfile host="app.diagrams.net">
  <diagram name="39_dev_compile_flow" id="39_dev_compile_flow">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="The compile step: language graph → compiled_part_t" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=20;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1500" height="31" as="geometry"/></mxCell>
        <mxCell id="c3" value='&lt;b&gt;1 root aggregate&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;create_merged_versions_entities&lt;/font&gt;: per root version, parked bodies first, then its statements' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="90" width="900" height="42" as="geometry"/></mxCell>
        <mxCell id="c4" value='&lt;b&gt;2 &lt;font face="Consolas"&gt;compile_merged_versions_entities&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;naming_unnamed_tags&lt;/font&gt; → &lt;font face="Consolas"&gt;remember_resolved_tag_names&lt;/font&gt; → &lt;font face="Consolas"&gt;remember_values_before&lt;/font&gt; →&lt;br&gt;per version: &lt;font face="Consolas"&gt;check_labels_in_version&lt;/font&gt; → &lt;font face="Consolas"&gt;compile_tags_in_version&lt;/font&gt; → &lt;font face="Consolas"&gt;template_engine::render&lt;/font&gt; → &lt;font face="Consolas"&gt;tag_container&lt;/font&gt;&lt;br&gt;root only: &lt;font face="Consolas"&gt;compile_orderings_in_version&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="162" width="900" height="74" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;3 every other aggregate&lt;/b&gt;&lt;br&gt;the same two calls, with the root's statements copied in first (unless the version is &lt;font face=&quot;Consolas&quot;&gt;local&lt;/font&gt; or &lt;font face=&quot;Consolas&quot;&gt;own&lt;/font&gt;)" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="266" width="900" height="42" as="geometry"/></mxCell>
        <mxCell id="c6" value='&lt;b&gt;4 &lt;font face="Consolas"&gt;notify_default_aggregates_ordering&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;ranks_of_ordering&lt;/font&gt;: topological sort, longest chain, strict weak order check → the position of each aggregate' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="338" width="900" height="42" as="geometry"/></mxCell>
        <mxCell id="c7" value='&lt;b&gt;5 &lt;font face="Consolas"&gt;force_resolve_labels&lt;/font&gt;&lt;/b&gt;&lt;br&gt;label references become static values' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="410" width="900" height="42" as="geometry"/></mxCell>
        <mxCell id="c8" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c9" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c10" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c11" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c12" value="&lt;b&gt;which statements reach a version&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="1010" y="90" width="1100" height="22" as="geometry"/></mxCell>
        <mxCell id="c13" value="same version" style="whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1010" y="124" width="480" height="36" as="geometry"/></mxCell>
        <mxCell id="c14" value="yes" style="whiteSpace=wrap;html=1;fillColor=#eef7ee;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1494" y="124" width="400" height="36" as="geometry"/></mxCell>
        <mxCell id="c15" value="later version" style="whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1010" y="168" width="480" height="36" as="geometry"/></mxCell>
        <mxCell id="c16" value="no" style="whiteSpace=wrap;html=1;fillColor=#fdf3f2;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1494" y="168" width="400" height="36" as="geometry"/></mxCell>
        <mxCell id="c17" value='earlier, mode &lt;font face="Consolas"&gt;inherit&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1010" y="212" width="480" height="36" as="geometry"/></mxCell>
        <mxCell id="c18" value="yes" style="whiteSpace=wrap;html=1;fillColor=#eef7ee;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1494" y="212" width="400" height="36" as="geometry"/></mxCell>
        <mxCell id="c19" value='earlier, mode &lt;font face="Consolas"&gt;local&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1010" y="256" width="480" height="36" as="geometry"/></mxCell>
        <mxCell id="c20" value="no" style="whiteSpace=wrap;html=1;fillColor=#fdf3f2;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1494" y="256" width="400" height="36" as="geometry"/></mxCell>
        <mxCell id="c21" value='earlier, mode &lt;font face="Consolas"&gt;own&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1010" y="300" width="480" height="36" as="geometry"/></mxCell>
        <mxCell id="c22" value="only this aggregate's" style="whiteSpace=wrap;html=1;fillColor=#fff9e0;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1494" y="300" width="400" height="36" as="geometry"/></mxCell>
        <mxCell id="c23" value='earlier, mode &lt;font face="Consolas"&gt;once&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1010" y="344" width="480" height="36" as="geometry"/></mxCell>
        <mxCell id="c24" value="only the root's" style="whiteSpace=wrap;html=1;fillColor=#fff9e0;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1494" y="344" width="400" height="36" as="geometry"/></mxCell>
        <mxCell id="c25" value='tag mode &lt;font face="Consolas"&gt;once&lt;/font&gt; / &lt;font face="Consolas"&gt;local&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1010" y="388" width="480" height="36" as="geometry"/></mxCell>
        <mxCell id="c26" value="only where written" style="whiteSpace=wrap;html=1;fillColor=#fff9e0;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1494" y="388" width="400" height="36" as="geometry"/></mxCell>
        <mxCell id="c27" value='&lt;b&gt;last declaration wins.&lt;/b&gt; &lt;font face="Consolas"&gt;compile_tags_in_version&lt;/font&gt; walks from the end; the first statement seen per name is kept, &lt;font face="Consolas"&gt;delete name;&lt;/font&gt; consumes&lt;br&gt;the name.&lt;br&gt;&lt;b&gt;an example&lt;/b&gt;&lt;br&gt;root v0 &lt;font face="Consolas"&gt;currency = EUR&lt;/font&gt; · Apple v0 &lt;font face="Consolas"&gt;price = 3&lt;/font&gt; · Apple v1 &lt;font face="Consolas"&gt;price = 4&lt;/font&gt;&lt;br&gt;compiled Apple v0: &lt;font face="Consolas"&gt;currency = EUR&lt;/font&gt;, &lt;font face="Consolas"&gt;price = 3&lt;/font&gt;&lt;br&gt;compiled Apple v1: &lt;font face="Consolas"&gt;currency = EUR&lt;/font&gt; (copied from the root), &lt;font face="Consolas"&gt;price = 4&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1010" y="450" width="884" height="170" as="geometry"/></mxCell>
      </root>
