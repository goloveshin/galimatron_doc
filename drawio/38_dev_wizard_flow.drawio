        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="The wizard step" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=20;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1500" height="31" as="geometry"/></mxCell>
        <mxCell id="c3" value='&lt;font face="Consolas"&gt;cpp2cpp_wizard::translate(language)&lt;/font&gt;&lt;br&gt;no wizard statement: return unchanged' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="90" width="420" height="60" as="geometry"/></mxCell>
        <mxCell id="c4" value='&lt;font face="Consolas"&gt;validate_-&amp;gt;is_wizard_command_single()&lt;/font&gt;&lt;br&gt;one statement in the whole graph' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="190" width="420" height="60" as="geometry"/></mxCell>
        <mxCell id="c5" value="batch?" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;shape=rhombus;perimeter=rhombusPerimeter" vertex="1" parent="1"><mxGeometry x="70" y="290" width="340" height="80" as="geometry"/></mxCell>
        <mxCell id="c6" value='&lt;font face="Consolas"&gt;apply_one(type)&lt;/font&gt;: a &lt;font face="Consolas"&gt;switch&lt;/font&gt; over &lt;font face="Consolas"&gt;command_et&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="420" width="420" height="50" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;apply_wizard_batch&lt;/b&gt;&lt;br&gt;• &lt;font face=&quot;Consolas&quot;&gt;may_execute_wizard_command()&lt;/font&gt;: the batch context&lt;br&gt;• for each item: &lt;font face=&quot;Consolas&quot;&gt;refresh_checks()&lt;/font&gt; (new memo, new checker, re-snapshot) → overwrite the stored&lt;br&gt;&amp;nbsp;&amp;nbsp;statement's &lt;font face=&quot;Consolas&quot;&gt;type&lt;/font&gt; and &lt;font face=&quot;Consolas&quot;&gt;data&lt;/font&gt; → &lt;font face=&quot;Consolas&quot;&gt;is_wizard_batch_command_create()&lt;/font&gt; → &lt;font face=&quot;Consolas&quot;&gt;apply_one(item.type)&lt;/font&gt;&lt;br&gt;• restore the statement" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="520" y="280" width="640" height="130" as="geometry"/></mxCell>
        <mxCell id="c8" value='&lt;b&gt;an &lt;font face="Consolas"&gt;apply_*&lt;/font&gt; function&lt;/b&gt;: &lt;font face="Consolas"&gt;validate_-&amp;gt;may_execute_wizard_command()&lt;/font&gt; (the per-command checks, in order; the first failure throws) → change the graph with &lt;font face="Consolas"&gt;builder_t&lt;/font&gt; (new vertices get&lt;br&gt;&lt;font face="Consolas"&gt;created_by_wizard&lt;/font&gt;) → &lt;font face="Consolas"&gt;refresh_live_and_hashed(vd_aggregate)&lt;/font&gt; after structural edits' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="520" width="1130" height="76" as="geometry"/></mxCell>
        <mxCell id="c9" value='&lt;font face="Consolas"&gt;comment_executed_command()&lt;/font&gt;: the text of the statement becomes &lt;font face="Consolas"&gt;//&lt;/font&gt; lines at the &lt;b&gt;top of its chunk&lt;/b&gt;; &lt;font face="Consolas"&gt;cpp2gal&lt;/font&gt; prints only comments for a wizard statement, so the command disappears' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="640" width="1130" height="60" as="geometry"/></mxCell>
