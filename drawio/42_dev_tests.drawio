<mxfile host="app.diagrams.net">
  <diagram name="42_dev_tests" id="42_dev_tests">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="How a product test runs" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=20;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1500" height="31" as="geometry"/></mxCell>
        <mxCell id="c3" value='&lt;b&gt;configure&lt;/b&gt;&lt;br&gt;CMake copies &lt;font face="Consolas"&gt;galimatron/tests/test_data&lt;/font&gt; to &lt;font face="Consolas"&gt;&amp;lt;build&amp;gt;/bin/galimatron_test_data&lt;/font&gt; (deleting the&lt;br&gt;old copy), copies the shared &lt;font face="Consolas"&gt;gal.cfg&lt;/font&gt;, &lt;font face="Consolas"&gt;log.cfg&lt;/font&gt;, &lt;font face="Consolas"&gt;xslt/config.xml&lt;/font&gt; into the cases, and on&lt;br&gt;Windows the &lt;font face="Consolas"&gt;expected-xml-windows&lt;/font&gt; files over &lt;font face="Consolas"&gt;expected-xml&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="90" width="560" height="190" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;the test&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot;&gt;translate_production(case_root)&lt;/font&gt; runs &lt;font face=&quot;Consolas&quot;&gt;runtime::translate&lt;/font&gt; with the&lt;br&gt;case's &lt;font face=&quot;Consolas&quot;&gt;gal.cfg&lt;/font&gt; and &lt;font face=&quot;Consolas&quot;&gt;log.cfg&lt;/font&gt;, &lt;font face=&quot;Consolas&quot;&gt;is_testing_mode = true&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="630" y="90" width="420" height="190" as="geometry"/></mxCell>
        <mxCell id="c5" value='&lt;b&gt;the run writes&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;actual_gal/&lt;/font&gt;, &lt;font face="Consolas"&gt;actual_xml/&lt;/font&gt;, &lt;font face="Consolas"&gt;intermediate/&lt;/font&gt;, &lt;font face="Consolas"&gt;actual_summary/&lt;/font&gt;,&lt;br&gt;&lt;font face="Consolas"&gt;actual_log/&lt;/font&gt;: inside the build copy' style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1090" y="90" width="420" height="190" as="geometry"/></mxCell>
        <mxCell id="c6" value='&lt;b&gt;the check&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;compare_directories&lt;/font&gt; (&lt;font face="Consolas"&gt;git diff --no-index&lt;/font&gt;): &lt;font face="Consolas"&gt;actual_gal&lt;/font&gt; against &lt;font face="Consolas"&gt;expected-gal&lt;/font&gt;, &lt;font face="Consolas"&gt;actual_xml&lt;/font&gt;&lt;br&gt;against &lt;font face="Consolas"&gt;expected-xml&lt;/font&gt;. For a failing case: &lt;font face="Consolas"&gt;print_leaf_exception&lt;/font&gt; with a handler' style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1550" y="90" width="560" height="190" as="geometry"/></mxCell>
        <mxCell id="c7" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c8" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c9" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c10" value='&lt;b&gt;test axes&lt;/b&gt;&amp;nbsp;&amp;nbsp;(&lt;font face="Consolas"&gt;test_axes::mark(...)&lt;/font&gt; in the suite description)' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="30" y="320" width="800" height="22" as="geometry"/></mxCell>
        <mxCell id="c11" value='&lt;font face="Consolas"&gt;product&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="354" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="c12" value='full integration: gal.cfg, log.cfg, &lt;font face="Consolas"&gt;translate_production&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="254" y="354" width="700" height="36" as="geometry"/></mxCell>
        <mxCell id="c13" value='&lt;font face="Consolas"&gt;translator_slice&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="398" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="c14" value='chosen built-in steps: &lt;font face="Consolas"&gt;translate_slice&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="254" y="398" width="700" height="36" as="geometry"/></mxCell>
        <mxCell id="c15" value='&lt;font face="Consolas"&gt;parser&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="442" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="c16" value="the grammar and the version rule" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="254" y="442" width="700" height="36" as="geometry"/></mxCell>
        <mxCell id="c17" value='&lt;font face="Consolas"&gt;component&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="486" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="c18" value="one helper" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="254" y="486" width="700" height="36" as="geometry"/></mxCell>
        <mxCell id="c19" value='&lt;font face="Consolas"&gt;process&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="30" y="530" width="220" height="36" as="geometry"/></mxCell>
        <mxCell id="c20" value="the crash handler in a child process" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="254" y="530" width="700" height="36" as="geometry"/></mxCell>
        <mxCell id="c21" value='&lt;b&gt;the rules&lt;/b&gt;&lt;br&gt;• product and slice tests never touch file bytes: only &lt;font face="Consolas"&gt;compare_directories&lt;/font&gt; and exception checks&lt;br&gt;• oracles hold no absolute path: a path is relative to the &lt;font face="Consolas"&gt;gal.cfg&lt;/font&gt; folder with &lt;font face="Consolas"&gt;/&lt;/font&gt; (&lt;font face="Consolas"&gt;report_path&lt;/font&gt;, &lt;font face="Consolas"&gt;committed-report&lt;/font&gt;)&lt;br&gt;• &lt;font face="Consolas"&gt;// good&lt;/font&gt; and &lt;font face="Consolas"&gt;// bad&lt;/font&gt; mark the line of an automated &lt;font face="Consolas"&gt;.gal&lt;/font&gt; fixture&lt;br&gt;• change a file that has a Windows twin → change both&lt;br&gt;• names must match in case (Linux)' style="whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1020" y="320" width="1150" height="190" as="geometry"/></mxCell>
        <mxCell id="c22" value='&lt;font face="Consolas"&gt;run_tests&lt;/font&gt; = &lt;font face="Consolas"&gt;global_tests&lt;/font&gt; → &lt;font face="Consolas"&gt;galimatron_tests&lt;/font&gt; → &lt;font face="Consolas"&gt;uuid_protocol_tests&lt;/font&gt;, in one cmake process, working directory &lt;font face="Consolas"&gt;bin/&lt;/font&gt;; on CI with &lt;font face="Consolas"&gt;--abort-after=1&lt;/font&gt;.' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="600" width="2140" height="44" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
