        <mxCell id="c477" value="P" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1544" y="2876" width="40" height="26" as="geometry"/></mxCell>
        <mxCell id="c478" value='&lt;font face="Consolas"&gt;is_wizard_delete_hash_*&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1588" y="2876" width="400" height="26" as="geometry"/></mxCell>
        <mxCell id="c479" value='&lt;font face="Consolas"&gt;apply_wizard_delete_hash → clear_hashes_of_version&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#eef7ee;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1992" y="2876" width="560" height="26" as="geometry"/></mxCell>
        <mxCell id="c480" value='&lt;font face="Consolas"&gt;BATCH&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1310" y="2906" width="230" height="26" as="geometry"/></mxCell>
        <mxCell id="c481" value="–" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1544" y="2906" width="40" height="26" as="geometry"/></mxCell>
        <mxCell id="c482" value='&lt;font face="Consolas"&gt;is_wizard_batch_*&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1588" y="2906" width="400" height="26" as="geometry"/></mxCell>
        <mxCell id="c483" value='&lt;font face="Consolas"&gt;apply_wizard_batch&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#eef7ee;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1992" y="2906" width="560" height="26" as="geometry"/></mxCell>
        <mxCell id="c484" value='Files: checks in &lt;font face="Consolas"&gt;cpp2cpp_validate/detail/wizard/wizard_{root,aggregate,version,statement}.cpp&lt;/font&gt;, changes in &lt;font face="Consolas"&gt;cpp2cpp_wizard/detail/{aggregate,version,statement,hash}.cpp&lt;/font&gt;. Messages are the constants of&lt;br&gt;&lt;font face="Consolas"&gt;state/wizard/tags.hpp&lt;/font&gt;.' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#666666;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="1310" y="2938" width="1240" height="32" as="geometry"/></mxCell>
        <mxCell id="c512" value='D  The compile step (&lt;font face="Consolas"&gt;cpp2post_cpp&lt;/font&gt;)' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bdbdbd;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2580" y="2378" width="2520" height="602" as="geometry"/></mxCell>
        <mxCell id="c485" value='&lt;font face="Consolas"&gt;cpp2post_cpp&lt;/font&gt; turns the language graph (what each version &lt;b&gt;says&lt;/b&gt;) into &lt;font face="Consolas"&gt;compiled_part_t&lt;/font&gt; (what each version &lt;b&gt;is&lt;/b&gt;). The language graph is not changed.' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#444444;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="2610" y="2422" width="2460" height="20" as="geometry"/></mxCell>
        <mxCell id="c486" value='&lt;b&gt;1&amp;nbsp;&amp;nbsp;register&lt;/b&gt; the label callback; &lt;b&gt;root aggregate first&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;create_merged_versions_entities&lt;/font&gt; (merge.cpp): for each root version, first the parked bodies (&lt;font face="Consolas"&gt;version before N&lt;/font&gt;) it owns,&lt;br&gt;then its own statements. &lt;font face="Consolas"&gt;delete;&lt;/font&gt; is skipped.' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2610" y="2470" width="760" height="55" as="geometry"/></mxCell>
        <mxCell id="c487" value='&lt;b&gt;2&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;compile_merged_versions_entities&lt;/font&gt;&lt;/b&gt; (compile_merged.cpp), once per aggregate&lt;br&gt;a. &lt;font face="Consolas"&gt;naming_unnamed_tags&lt;/font&gt;: a tag without a name takes it from a &lt;font face="Consolas"&gt;tag-name-from&lt;/font&gt; label (must match &lt;font face="Consolas"&gt;identifier_pattern&lt;/font&gt;)&lt;br&gt;b. &lt;font face="Consolas"&gt;remember_values_before&lt;/font&gt;: the value just before each statement, for the history&lt;br&gt;c. per version: &lt;font face="Consolas"&gt;check_labels_in_version&lt;/font&gt; → &lt;font face="Consolas"&gt;compile_tags_in_version&lt;/font&gt; → &lt;font face="Consolas"&gt;template_engine::render&lt;/font&gt; → write &lt;font face="Consolas"&gt;tag_container&lt;/font&gt;&lt;br&gt;d. root only: &lt;font face="Consolas"&gt;compile_orderings_in_version&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2610" y="2547" width="760" height="85" as="geometry"/></mxCell>
        <mxCell id="c488" value="&lt;b&gt;3&amp;nbsp;&amp;nbsp;each other aggregate&lt;/b&gt;, in file order&lt;br&gt;the same two calls. The root's statements of each version are copied in first, so an aggregate can override them. Not&lt;br&gt;copied: a root tag with mode &lt;font face=&quot;Consolas&quot;&gt;local&lt;/font&gt;; nothing at all when the aggregate's version mode is &lt;font face=&quot;Consolas&quot;&gt;local&lt;/font&gt; or &lt;font face=&quot;Consolas&quot;&gt;own&lt;/font&gt;. A deleted version&lt;br&gt;has no body." style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2610" y="2654" width="760" height="70" as="geometry"/></mxCell>
        <mxCell id="c489" value='&lt;b&gt;4&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;notify_default_aggregates_ordering&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;ranks_of_ordering&lt;/font&gt;: a directed graph from the &lt;font face="Consolas"&gt;{A, B, C}&lt;/font&gt; chains, topological sort, rank = longest chain of predecessors, and&lt;br&gt;a check that the result is a strict weak order. Unnamed aggregates follow, in file order. The stored index is the final&lt;br&gt;&lt;b&gt;position&lt;/b&gt;.' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2610" y="2746" width="760" height="70" as="geometry"/></mxCell>
        <mxCell id="c490" value='&lt;b&gt;5&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;force_resolve_labels&lt;/font&gt;&lt;/b&gt;&lt;br&gt;every label reference becomes its static value. The compiled part keeps no label references.' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2610" y="2838" width="760" height="40" as="geometry"/></mxCell>
        <mxCell id="c491" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c486" target="c487"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c492" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c487" target="c488"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c493" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c488" target="c489"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c494" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c489" target="c490"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c495" value='&lt;b&gt;which statements reach a version&lt;/b&gt;&amp;nbsp;&amp;nbsp;(&lt;font face="Consolas"&gt;statement_reaches_version&lt;/font&gt;)' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="3410" y="2456" width="1000" height="20" as="geometry"/></mxCell>
        <mxCell id="c496" value="the statement is in the same version" style="whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3410" y="2486" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="c497" value="visible" style="whiteSpace=wrap;html=1;fillColor=#eef7ee;strokeColor=#cccccc;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3814" y="2486" width="560" height="34" as="geometry"/></mxCell>
        <mxCell id="c498" value="the statement is in a later version" style="whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3410" y="2524" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="c499" value="never" style="whiteSpace=wrap;html=1;fillColor=#fdf3f2;strokeColor=#cccccc;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3814" y="2524" width="560" height="34" as="geometry"/></mxCell>
        <mxCell id="c500" value='earlier version, version mode &lt;font face="Consolas"&gt;inherit&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3410" y="2562" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="c501" value="visible" style="whiteSpace=wrap;html=1;fillColor=#eef7ee;strokeColor=#cccccc;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3814" y="2562" width="560" height="34" as="geometry"/></mxCell>
        <mxCell id="c502" value='earlier version, version mode &lt;font face="Consolas"&gt;local&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3410" y="2600" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="c503" value="invisible" style="whiteSpace=wrap;html=1;fillColor=#fdf3f2;strokeColor=#cccccc;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3814" y="2600" width="560" height="34" as="geometry"/></mxCell>
        <mxCell id="c504" value='earlier version, version mode &lt;font face="Consolas"&gt;own&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3410" y="2638" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="c505" value="only statements of this aggregate (the root is dropped)" style="whiteSpace=wrap;html=1;fillColor=#fff9e0;strokeColor=#cccccc;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3814" y="2638" width="560" height="34" as="geometry"/></mxCell>
        <mxCell id="c506" value='earlier version, version mode &lt;font face="Consolas"&gt;once&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3410" y="2676" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="c507" value="only statements of the root (this aggregate's earlier ones drop)" style="whiteSpace=wrap;html=1;fillColor=#fff9e0;strokeColor=#cccccc;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3814" y="2676" width="560" height="34" as="geometry"/></mxCell>
        <mxCell id="c508" value='tag mode &lt;font face="Consolas"&gt;once&lt;/font&gt; or &lt;font face="Consolas"&gt;local&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3410" y="2714" width="400" height="34" as="geometry"/></mxCell>
        <mxCell id="c509" value="only in the version where it is written (never from a parked body)" style="whiteSpace=wrap;html=1;fillColor=#fff9e0;strokeColor=#cccccc;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3814" y="2714" width="560" height="34" as="geometry"/></mxCell>
        <mxCell id="c510" value="&lt;b&gt;last declaration wins&lt;/b&gt;: &lt;font face=&quot;Consolas&quot;&gt;compile_tags_in_version&lt;/font&gt; walks the statements from the end; the first one seen per resolved name is kept, and a &lt;font face=&quot;Consolas&quot;&gt;delete name;&lt;/font&gt; consumes&lt;br&gt;the name. Deleting a label is an error. Deleting an absent tag only logs a warning.&lt;br&gt;&lt;b&gt;templates&lt;/b&gt;: &lt;font face=&quot;Consolas&quot;&gt;template_engine::render&lt;/font&gt; builds JSON from the version's tags (several values → an array, &lt;font face=&quot;Consolas&quot;&gt;{{name}}&lt;/font&gt; means &lt;font face=&quot;Consolas&quot;&gt;{{name.0}}&lt;/font&gt;) and renders each &lt;font face=&quot;Consolas&quot;&gt;_te&lt;/font&gt; string&lt;br&gt;with inja. The result is stored per (version, string); the language graph keeps the raw text.&lt;br&gt;&lt;b&gt;errors&lt;/b&gt;: &lt;font face=&quot;Consolas&quot;&gt;throw_compiler(text)&lt;/font&gt; = LEAF &lt;font face=&quot;Consolas&quot;&gt;cpp2post_cpp&lt;/font&gt; + &lt;font face=&quot;Consolas&quot;&gt;e_what_info&lt;/font&gt;, with path (through &lt;font face=&quot;Consolas&quot;&gt;report_path&lt;/font&gt;), aggregate and version attached." style="whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3410" y="2760" width="964" height="85" as="geometry"/></mxCell>
        <mxCell id="c511" value='&lt;b&gt;a small example&lt;/b&gt;&lt;br&gt;language: root &lt;font face="Consolas"&gt;version 0 { currency = { "EUR" }; }&lt;/font&gt;, &lt;font face="Consolas"&gt;Apple&lt;/font&gt; &lt;font face="Consolas"&gt;version 0 { price = { "3" }; }&lt;/font&gt;, &lt;font face="Consolas"&gt;Apple&lt;/font&gt; &lt;font face="Consolas"&gt;version 1 { price = { "4" }; }&lt;/font&gt;&lt;br&gt;compiled &lt;font face="Consolas"&gt;Apple&lt;/font&gt;, version 0:&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;currency = EUR&lt;/font&gt;, &lt;font face="Consolas"&gt;price = 3&lt;/font&gt;&lt;br&gt;compiled &lt;font face="Consolas"&gt;Apple&lt;/font&gt;, version 1:&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;currency = EUR&lt;/font&gt; (from the root, copied in), &lt;font face="Consolas"&gt;price = 4&lt;/font&gt; (the last declaration wins)&lt;br&gt;Version 1 of &lt;font face="Consolas"&gt;Apple&lt;/font&gt; never repeated the currency: the compiled XML says it for every version.' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3410" y="2865" width="964" height="85" as="geometry"/></mxCell>
        <mxCell id="c549" value="E  The XML round trip and the layout table" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bdbdbd;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="3030" width="2500" height="509" as="geometry"/></mxCell>
        <mxCell id="c514" value="The XML is the only thing an xslt sees, but the &lt;b&gt;source text and comments&lt;/b&gt; live on graph vertices. A side table carries them across the round trip." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#444444;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="70" y="3074" width="2440" height="20" as="geometry"/></mxCell>
        <mxCell id="c515" value='&lt;b&gt;&lt;font face="Consolas"&gt;language_part_t&lt;/font&gt;&lt;/b&gt;&lt;br&gt;vertices keep &lt;font face="Consolas"&gt;user_formatting&lt;/font&gt; (source text) and&lt;br&gt;&lt;font face="Consolas"&gt;user_comments&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="70" y="3126" width="360" height="96" as="geometry"/></mxCell>
        <mxCell id="c516" value='&lt;b&gt;&lt;font face="Consolas"&gt;cpp2xml::translate&lt;/font&gt;&lt;/b&gt;&lt;br&gt;clears the layout table. For each vertex that has text or comments:&lt;br&gt;counts &lt;font face="Consolas"&gt;++next&lt;/font&gt;, writes &lt;font face="Consolas"&gt;layout-mark="N"&lt;/font&gt;, stores &amp;#96;{formatting, comments,&lt;br&gt;fingerprint}&amp;#96; under N' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="510" y="3126" width="440" height="96" as="geometry"/></mxCell>
        <mxCell id="c517" value='&lt;b&gt;language XML&lt;/b&gt;&lt;br&gt;printed, then parsed into Saxon by &lt;font face="Consolas"&gt;xml2saxon&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1030" y="3126" width="330" height="96" as="geometry"/></mxCell>
        <mxCell id="c518" value="&lt;b&gt;your xslt&lt;/b&gt;&lt;br&gt;may change, add or delete any element" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1440" y="3126" width="330" height="96" as="geometry"/></mxCell>
        <mxCell id="c519" value='&lt;b&gt;&lt;font face="Consolas"&gt;xml2cpp_saxon&lt;/font&gt;&lt;/b&gt;: &lt;font face="Consolas"&gt;builder_t&lt;/font&gt; builds a new graph. &lt;font face="Consolas"&gt;restore_layout&lt;/font&gt;: comments always come back; the source text&lt;br&gt;comes back only when &lt;font face="Consolas"&gt;fingerprint(node)&lt;/font&gt; still equals the stored one, so an edited node is printed fresh&lt;br&gt;by &lt;font face="Consolas"&gt;cpp2gal&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1850" y="3126" width="650" height="96" as="geometry"/></mxCell>
        <mxCell id="c520" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c515" target="c516"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c521" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c516" target="c517"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c522" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c517" target="c518"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c523" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c518" target="c519"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c524" value='&lt;b&gt;fingerprint&lt;/b&gt;: element name, attributes except &lt;font face="Consolas"&gt;layout-mark&lt;/font&gt; (sorted), children, and non-blank text. Two implementations (&lt;font face="Consolas"&gt;layout::fingerprint&lt;/font&gt; on pugixml, &lt;font face="Consolas"&gt;fingerprint&lt;/font&gt; on &lt;font face="Consolas"&gt;node_t&lt;/font&gt;) must give the same text for the same XML.' style="whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="70" y="3246" width="2440" height="46" as="geometry"/></mxCell>
        <mxCell id="c525" value='&lt;b&gt;language XML&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;&amp;lt;galimatron&amp;gt;&amp;lt;language&amp;gt;&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="70" y="3312" width="1210" height="30" as="geometry"/></mxCell>
        <mxCell id="c526" value='&lt;b&gt;compiled XML&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;&amp;lt;galimatron&amp;gt;&amp;lt;compiled&amp;gt;&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1300" y="3312" width="1210" height="30" as="geometry"/></mxCell>
        <mxCell id="c527" value='&lt;font face="Consolas"&gt;&amp;lt;chunk&amp;gt;&amp;lt;location&amp;gt;&amp;lt;filesystem path root relative …/&amp;gt;&amp;lt;/location&amp;gt;&lt;/font&gt; per file&lt;br&gt;&lt;font face="Consolas"&gt;&amp;lt;root-aggregate name&amp;gt;&lt;/font&gt; / &lt;font face="Consolas"&gt;&amp;lt;aggregate name index&amp;gt;&lt;/font&gt; with &lt;font face="Consolas"&gt;…-version-declarations&lt;/font&gt; (&lt;font face="Consolas"&gt;index status comment hash&lt;/font&gt;) and &lt;font face="Consolas"&gt;…-version-definitions&lt;/font&gt; (&lt;font face="Consolas"&gt;index&lt;/font&gt; or &lt;font face="Consolas"&gt;owner&lt;/font&gt;, &lt;font face="Consolas"&gt;mode&lt;/font&gt;)&lt;br&gt;&lt;font face="Consolas"&gt;&amp;lt;tag index name mode layout-mark&amp;gt;&lt;/font&gt; with &lt;font face="Consolas"&gt;&amp;lt;label-refs&amp;gt;&amp;lt;static&amp;gt;&amp;lt;label-ref name index/&amp;gt;&lt;/font&gt;, &lt;font face="Consolas"&gt;&amp;lt;values&amp;gt;&amp;lt;value index&amp;gt;&amp;lt;string delimiter template-engine&amp;gt;&lt;/font&gt;, records, arrays&lt;br&gt;&lt;font face="Consolas"&gt;&amp;lt;label index name&amp;gt;&lt;/font&gt; with &lt;font face="Consolas"&gt;&amp;lt;static&amp;gt;&amp;lt;values&amp;gt;…&amp;lt;tag-name-from/&amp;gt;&lt;/font&gt; or &lt;font face="Consolas"&gt;&amp;lt;dynamic value/&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font face="Consolas"&gt;&amp;lt;ordering index name&amp;gt;&lt;/font&gt;, &lt;font face="Consolas"&gt;&amp;lt;delete index name?/&amp;gt;&lt;/font&gt;&lt;br&gt;Wizard marks: &lt;font face="Consolas"&gt;&amp;lt;dynamic wizard="new-version|new-aggregate|new-root-aggregate"/&amp;gt;&lt;/font&gt;, and &lt;font face="Consolas"&gt;&amp;lt;dynamic labelname="value"/&amp;gt;&lt;/font&gt; on a copied tag that uses a dynamic label&lt;br&gt;&lt;font face="Consolas"&gt;&amp;lt;string-delimiters&amp;gt;&lt;/font&gt;, and &lt;font face="Consolas"&gt;&amp;lt;history&amp;gt;&lt;/font&gt; beside &lt;font face="Consolas"&gt;&amp;lt;language&amp;gt;&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="70" y="3346" width="1210" height="115" as="geometry"/></mxCell>
        <mxCell id="c528" value='the same skeleton, but each version lists only the &lt;b&gt;effective tags&lt;/b&gt; of the compiled state, in order&lt;br&gt;a tag &lt;b&gt;always has its name&lt;/b&gt; (resolved from &lt;font face="Consolas"&gt;tag-name-from&lt;/font&gt;)&lt;br&gt;no label statements, no &lt;font face="Consolas"&gt;label-refs&lt;/font&gt;: each static label becomes an &lt;b&gt;attribute on &lt;font face="Consolas"&gt;&amp;lt;value&amp;gt;&lt;/font&gt;&lt;/b&gt;, &lt;font face="Consolas"&gt;&amp;lt;value index="0" field="type"&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font face="Consolas"&gt;&amp;lt;string&amp;gt;&lt;/font&gt; holds the &lt;b&gt;rendered&lt;/b&gt; text and no &lt;font face="Consolas"&gt;template-engine&lt;/font&gt; mark&lt;br&gt;&lt;font face="Consolas"&gt;&amp;lt;orderings&amp;gt;&amp;lt;ordering name index="position"/&amp;gt;&amp;lt;/orderings&amp;gt;&lt;/font&gt; under each aggregate version definition&lt;br&gt;no Wizard marks&lt;br&gt;&lt;font face="Consolas"&gt;&amp;lt;history&amp;gt;&lt;/font&gt;: per version, per aggregate, the changes (&lt;font face="Consolas"&gt;add&lt;/font&gt;, &lt;font face="Consolas"&gt;replace&lt;/font&gt;, &lt;font face="Consolas"&gt;delete&lt;/font&gt;, &lt;font face="Consolas"&gt;label&lt;/font&gt;, &lt;font face="Consolas"&gt;ordering&lt;/font&gt;, &lt;font face="Consolas"&gt;create-aggregate&lt;/font&gt;, &lt;font face="Consolas"&gt;delete-version&lt;/font&gt;)' style="whiteSpace=wrap;html=1;fillColor=#fff8ee;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1300" y="3346" width="1210" height="115" as="geometry"/></mxCell>
        <mxCell id="c548" value="F  Where the output of a step goes" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bdbdbd;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2580" y="3030" width="2520" height="509" as="geometry"/></mxCell>
        <mxCell id="c529" value="&lt;font face=&quot;Consolas&quot;&gt;process_result&lt;/font&gt; (runtime) receives every step's output &lt;b&gt;while the run goes on&lt;/b&gt; and sends it to a place of the filesystem decorator." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#444444;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="2610" y="3074" width="2460" height="20" as="geometry"/></mxCell>
        <mxCell id="c530" value='&lt;b&gt;step result&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;produced_xml&lt;/font&gt;, &lt;font face="Consolas"&gt;produced_files&lt;/font&gt;,&lt;br&gt;status, config transform' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2610" y="3126" width="330" height="76" as="geometry"/></mxCell>
        <mxCell id="c531" value='&lt;font face="Consolas"&gt;produced_xml&lt;/font&gt; → &lt;b&gt;intermediate place&lt;/b&gt;&lt;br&gt;separate mode: &lt;font face="Consolas"&gt;&amp;lt;filesystem&amp;gt;&lt;/font&gt; elements are dropped from the text,&lt;br&gt;so no absolute path is written' style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3010" y="3126" width="400" height="76" as="geometry"/></mxCell>
        <mxCell id="c532" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c530" target="c531"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c533" value='&lt;font face="Consolas"&gt;produced_files&lt;/font&gt;, each one by the kind of its path:' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="2610" y="3220" width="600" height="19" as="geometry"/></mxCell>
        <mxCell id="c534" value='step is &lt;font face="Consolas"&gt;cpp2gal&lt;/font&gt; (named CPP2GAL)' style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2610" y="3246" width="880" height="36" as="geometry"/></mxCell>
        <mxCell id="c535" value="old path is split by the &lt;b&gt;output .gal place&lt;/b&gt; root; written there (normal mode: held until the end)" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3530" y="3246" width="1000" height="36" as="geometry"/></mxCell>
        <mxCell id="c536" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c534" target="c535"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c537" value='path &lt;font face="Consolas"&gt;@@alias@@relative@@&lt;/font&gt; (an &lt;font face="Consolas"&gt;xsl:result-document href&lt;/font&gt;)' style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2610" y="3290" width="880" height="36" as="geometry"/></mxCell>
        <mxCell id="c538" value='the store with that alias (&lt;b&gt;its own place&lt;/b&gt;), &lt;font face="Consolas"&gt;replace-escaped-form-to-original-symbols&lt;/font&gt; applied if set' style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3530" y="3290" width="1000" height="36" as="geometry"/></mxCell>
        <mxCell id="c539" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c537" target="c538"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c540" value="a relative path" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2610" y="3334" width="880" height="36" as="geometry"/></mxCell>
        <mxCell id="c541" value="&lt;b&gt;intermediate place&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3530" y="3334" width="1000" height="36" as="geometry"/></mxCell>
        <mxCell id="c542" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c540" target="c541"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c543" value="an absolute path" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2610" y="3378" width="880" height="36" as="geometry"/></mxCell>
        <mxCell id="c544" value='&lt;font face="Consolas"&gt;filesystem.write&lt;/font&gt; directly: the decorator is &lt;b&gt;bypassed&lt;/b&gt;' style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3530" y="3378" width="1000" height="36" as="geometry"/></mxCell>
        <mxCell id="c545" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c543" target="c544"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c546" value="&lt;b&gt;the decorator's &lt;font face=&quot;Consolas&quot;&gt;printout&lt;/font&gt;&lt;/b&gt; (&lt;font face=&quot;Consolas&quot;&gt;filesystem_decorator.cpp&lt;/font&gt;): split the old path by the owning place → merge with the new parts (the place root wins) → &lt;font face=&quot;Consolas&quot;&gt;write.once&lt;/font&gt; and already saved? &lt;b&gt;error&lt;/b&gt; → mark the file as rewritten (so the end-of-run cleanup keeps it) → &lt;font face=&quot;Consolas&quot;&gt;if_content_differ&lt;/font&gt;: compare with cache or disk → write now, or set &lt;font face=&quot;Consolas&quot;&gt;pending_write&lt;/font&gt; for &lt;font face=&quot;Consolas&quot;&gt;do_jobs_at_end&lt;/font&gt;.&lt;br&gt;It returns &lt;font face=&quot;Consolas&quot;&gt;finally_path&lt;/font&gt;. &lt;font face=&quot;Consolas&quot;&gt;process_result&lt;/font&gt; turns those paths into the summary entry (relative to &lt;font face=&quot;Consolas&quot;&gt;gal.cfg&lt;/font&gt; with &lt;font face=&quot;Consolas&quot;&gt;committed-report&lt;/font&gt;)." style="whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2610" y="3430" width="2460" height="40" as="geometry"/></mxCell>
        <mxCell id="c547" value='&lt;b&gt;Saxon side&lt;/b&gt; (&lt;font face="Consolas"&gt;saxon_session_t&lt;/font&gt;): parameters are set before compiling and are strings only; &lt;font face="Consolas"&gt;setCaptureResultDocuments(true)&lt;/font&gt;; &lt;font face="Consolas"&gt;xsl:message&lt;/font&gt; text goes to the log between &lt;font face="Consolas"&gt;begin messages from Saxon&lt;/font&gt; and &lt;font face="Consolas"&gt;end messages from Saxon&lt;/font&gt;; each result document becomes &lt;font face="Consolas"&gt;{content = node-&amp;gt;toString(), path = href}&lt;/font&gt;. A &lt;font face="Consolas"&gt;SaxonApiException&lt;/font&gt; is turned into text first (&lt;font face="Consolas"&gt;printout_native_saxon_exception&lt;/font&gt;), then thrown as LEAF &lt;font face="Consolas"&gt;translator&lt;/font&gt;.' style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2610" y="3484" width="2460" height="25" as="geometry"/></mxCell>
        <mxCell id="c605" value='G  The seal (&lt;font face="Consolas"&gt;cpp2cpp_after_xslt&lt;/font&gt;)' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bdbdbd;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="3589" width="1700" height="486" as="geometry"/></mxCell>
        <mxCell id="c550" value='&lt;font face="Consolas"&gt;reassign_sealed_edits(before, after)&lt;/font&gt; keeps closed versions closed when your language xslt changes them.' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#444444;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="70" y="3633" width="1640" height="20" as="geometry"/></mxCell>
        <mxCell id="c551" value='no root, or no hashed version (&lt;font face="Consolas"&gt;last_hashed&lt;/font&gt;) → return &lt;font face="Consolas"&gt;after&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="70" y="3681" width="1640" height="25" as="geometry"/></mxCell>
        <mxCell id="c552" value='&lt;font face="Consolas"&gt;reject_sealed_shape&lt;/font&gt;: an aggregate removed, or a version inserted into the sealed history → &lt;b&gt;error&lt;/b&gt;' style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="70" y="3720" width="1640" height="25" as="geometry"/></mxCell>
        <mxCell id="c553" value='&lt;font face="Consolas"&gt;sealed_history_differs&lt;/font&gt;? compare hash, comment, status and &lt;font face="Consolas"&gt;definition_payload&lt;/font&gt; of every sealed version. No → return &lt;font face="Consolas"&gt;after&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="70" y="3759" width="1640" height="25" as="geometry"/></mxCell>
        <mxCell id="c554" value='&lt;font face="Consolas"&gt;effective_edits&lt;/font&gt;: compile both graphs, diff the &lt;b&gt;effective tags&lt;/b&gt; of the last sealed version → &lt;font face="Consolas"&gt;REASSIGN&lt;/font&gt; or &lt;font face="Consolas"&gt;DELETE_TAG&lt;/font&gt; per aggregate' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="70" y="3798" width="1640" height="25" as="geometry"/></mxCell>
        <mxCell id="c555" value='only Wizard copies that use a dynamic label? Then the xslt only finished them: &lt;font face="Consolas"&gt;write_version_hash(after, last_sealed)&lt;/font&gt; refreshes the hash and return' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="70" y="3837" width="1640" height="25" as="geometry"/></mxCell>
        <mxCell id="c556" value='&lt;font face="Consolas"&gt;restore_sealed_history&lt;/font&gt;: every sealed version of &lt;font face="Consolas"&gt;after&lt;/font&gt; is replaced by a clone from &lt;font face="Consolas"&gt;before&lt;/font&gt; (hash, comment, status, presentation, children)' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="70" y="3876" width="1640" height="25" as="geometry"/></mxCell>
        <mxCell id="c557" value="no effective edits → return (the xslt changes were only formatting)" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="70" y="3915" width="1640" height="25" as="geometry"/></mxCell>
        <mxCell id="c558" value='&lt;font face="Consolas"&gt;destination_version&lt;/font&gt;: the first open version after &lt;font face="Consolas"&gt;last_sealed&lt;/font&gt;, or &lt;font face="Consolas"&gt;open_next_version&lt;/font&gt; creates one for every live aggregate' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="70" y="3954" width="1640" height="25" as="geometry"/></mxCell>
        <mxCell id="c559" value='&lt;font face="Consolas"&gt;write_edits&lt;/font&gt;: clone each changed tag into that version (marked &lt;font face="Consolas"&gt;created_by_wizard&lt;/font&gt;), or write &lt;font face="Consolas"&gt;delete name;&lt;/font&gt;. A tag already named there is not touched' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="70" y="3993" width="1640" height="25" as="geometry"/></mxCell>
        <mxCell id="c560" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c551" target="c552"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c561" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c552" target="c553"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c562" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c553" target="c554"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c563" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c554" target="c555"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c564" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c555" target="c556"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c565" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c556" target="c557"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c566" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c557" target="c558"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c567" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c558" target="c559"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c604" value="H  Errors" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bdbdbd;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1790" y="3589" width="1700" height="486" as="geometry"/></mxCell>
        <mxCell id="c568" value='Errors are Boost.LEAF exceptions with a &lt;b&gt;domain&lt;/b&gt;, a &lt;b&gt;subdomain&lt;/b&gt; and payloads. Thrown inside &lt;font face="Consolas"&gt;galimatron&lt;/font&gt;, caught in the runtime, printed once.' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#444444;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="1820" y="3633" width="1640" height="20" as="geometry"/></mxCell>
        <mxCell id="c569" value='&lt;b&gt;throw&lt;/b&gt;: &lt;font face="Consolas"&gt;leaf::throw_exception(domain, subdomain, e_what_info, [code], …)&lt;/font&gt;&lt;br&gt;context by RAII guards: &lt;font face="Consolas"&gt;augment_domain&lt;/font&gt;, &lt;font face="Consolas"&gt;augment_path&lt;/font&gt;, &lt;font face="Consolas"&gt;augment_aggregate&lt;/font&gt;, &lt;font face="Consolas"&gt;augment_version&lt;/font&gt;, &lt;font face="Consolas"&gt;augment_where&lt;/font&gt; (keep the returned&lt;br&gt;object alive)&lt;br&gt;types only in &lt;font face="Consolas"&gt;common_library/exception_declaration.hpp&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1820" y="3685" width="760" height="70" as="geometry"/></mxCell>
        <mxCell id="c570" value="&lt;b&gt;on the main thread&lt;/b&gt; the exception travels to the nearest &lt;font face=&quot;Consolas&quot;&gt;try_catch&lt;/font&gt;.&lt;br&gt;&lt;b&gt;on a Taskflow worker&lt;/b&gt; there is no LEAF context: &lt;font face=&quot;Consolas&quot;&gt;capture_or_rethrow&lt;/font&gt; runs the code under &lt;font face=&quot;Consolas&quot;&gt;leaf::try_capture_all&lt;/font&gt; and throws&lt;br&gt;&lt;font face=&quot;Consolas&quot;&gt;captured_leaf_exception&lt;/font&gt;. &lt;font face=&quot;Consolas&quot;&gt;subflow.join()&lt;/font&gt; or &lt;font face=&quot;Consolas&quot;&gt;future.get()&lt;/font&gt; rethrows it on the caller's thread, and &lt;font face=&quot;Consolas&quot;&gt;leaf_spy&lt;/font&gt; unloads the payloads&lt;br&gt;there." style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2620" y="3685" width="810" height="70" as="geometry"/></mxCell>
        <mxCell id="c571" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c569" target="c570"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c572" value='&lt;b&gt;inner catch&lt;/b&gt;: &lt;font face="Consolas"&gt;translate_by_config&lt;/font&gt; → &lt;font face="Consolas"&gt;runtime::try_catch&lt;/font&gt;, &lt;font face="Consolas"&gt;is_throw_out = true&lt;/font&gt;. &lt;font face="Consolas"&gt;leaf_spy::spy_handler_t&lt;/font&gt; loads every domain,&lt;br&gt;subdomain, enum and payload, prints &lt;font face="Consolas"&gt;Exception details:&lt;/font&gt; into a stream; &lt;font face="Consolas"&gt;notify_printed&lt;/font&gt; copies the text into the summary&lt;br&gt;&lt;font face="Consolas"&gt;&amp;lt;error&amp;gt;&lt;/font&gt;; the exception goes on.' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1820" y="3845" width="760" height="55" as="geometry"/></mxCell>
        <mxCell id="c573" value='&lt;b&gt;outer catch&lt;/b&gt;: &lt;font face="Consolas"&gt;translate_impl_t::translate&lt;/font&gt; → the same wrapper; the text is logged with &lt;font face="Consolas"&gt;fLogmeE&lt;/font&gt;; the result is 1. &lt;font face="Consolas"&gt;is_testing_mode&lt;/font&gt;&lt;br&gt;lets the exception leave &lt;font face="Consolas"&gt;translate()&lt;/font&gt; in tests, which print it with &lt;font face="Consolas"&gt;print_leaf_exception&lt;/font&gt;.' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2620" y="3845" width="810" height="40" as="geometry"/></mxCell>
        <mxCell id="c574" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c572" target="c573"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c575" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c570" target="c572"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c576" value="Not LEAF: syntax errors are &lt;font face=&quot;Consolas&quot;&gt;antlr4::ParseCancellationException&lt;/font&gt; (the spy prints them with a &lt;font face=&quot;Consolas&quot;&gt;dynamic_cast&lt;/font&gt;); a bad log config or a failed &lt;font face=&quot;Consolas&quot;&gt;merge_paths&lt;/font&gt; is &lt;font face=&quot;Consolas&quot;&gt;std::runtime_error&lt;/font&gt;. Both show &quot;NO DOMAIN-SPECIFIC EXCEPTION CATEGORY MATCHED&quot; in the printout.&lt;br&gt;The path in the printed text is spelled from copies in &lt;font face=&quot;Consolas&quot;&gt;e_path_info&lt;/font&gt; (&lt;font face=&quot;Consolas&quot;&gt;committed_report&lt;/font&gt;, &lt;font face=&quot;Consolas&quot;&gt;config_dir&lt;/font&gt;), because the run's path report may be gone when the text is built." style="whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1820" y="4005" width="1640" height="40" as="geometry"/></mxCell>
        <mxCell id="c603" value="I  The places of the filesystem decorator" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bdbdbd;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="3540" y="3589" width="1560" height="486" as="geometry"/></mxCell>
        <mxCell id="c577" value='A &lt;b&gt;place&lt;/b&gt; is a folder with rules. Every file the translator writes goes through one, except the summary, &lt;font face="Consolas"&gt;taskflow.dot&lt;/font&gt; and absolute user paths.' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#444444;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="3570" y="3633" width="1500" height="20" as="geometry"/></mxCell>
        <mxCell id="c578" value="place" style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="3570" y="3685" width="336" height="26" as="geometry"/></mxCell>
        <mxCell id="c579" value="read" style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="3910" y="3685" width="96" height="26" as="geometry"/></mxCell>
        <mxCell id="c580" value="write" style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="4010" y="3685" width="356" height="26" as="geometry"/></mxCell>
        <mxCell id="c581" value="remove" style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="4370" y="3685" width="326" height="26" as="geometry"/></mxCell>
        <mxCell id="c582" value="input/output .gal&amp;nbsp;&amp;nbsp;(normal mode)" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3570" y="3715" width="336" height="38" as="geometry"/></mxCell>
        <mxCell id="c583" value="cached" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3910" y="3715" width="96" height="38" as="geometry"/></mxCell>
        <mxCell id="c584" value="held until the end of a &lt;b&gt;successful&lt;/b&gt; run; only if the text&lt;br&gt;changed; once" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="4010" y="3715" width="356" height="38" as="geometry"/></mxCell>
        <mxCell id="c585" value="files not rewritten: removed at the end" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="4370" y="3715" width="326" height="38" as="geometry"/></mxCell>
        <mxCell id="c586" value="input .gal&amp;nbsp;&amp;nbsp;(separate)" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3570" y="3757" width="336" height="24" as="geometry"/></mxCell>
        <mxCell id="c587" value="not cached" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3910" y="3757" width="96" height="24" as="geometry"/></mxCell>
        <mxCell id="c588" value="–" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="4010" y="3757" width="356" height="24" as="geometry"/></mxCell>
        <mxCell id="c589" value="–" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="4370" y="3757" width="326" height="24" as="geometry"/></mxCell>
        <mxCell id="c590" value="output .gal&amp;nbsp;&amp;nbsp;(separate)" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3570" y="3785" width="336" height="24" as="geometry"/></mxCell>
        <mxCell id="c591" value="–" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3910" y="3785" width="96" height="24" as="geometry"/></mxCell>
        <mxCell id="c592" value="at once; once" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="4010" y="3785" width="356" height="24" as="geometry"/></mxCell>
        <mxCell id="c593" value="all .gal removed at the start" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="4370" y="3785" width="326" height="24" as="geometry"/></mxCell>
        <mxCell id="c594" value="intermediate xml&amp;nbsp;&amp;nbsp;(.xml, .html)" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3570" y="3813" width="336" height="24" as="geometry"/></mxCell>
        <mxCell id="c595" value="not cached" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3910" y="3813" width="96" height="24" as="geometry"/></mxCell>
        <mxCell id="c596" value="at once; once" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="4010" y="3813" width="356" height="24" as="geometry"/></mxCell>
        <mxCell id="c597" value="all removed at the start" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="4370" y="3813" width="326" height="24" as="geometry"/></mxCell>
        <mxCell id="c598" value='store of &lt;font face="Consolas"&gt;other-files&lt;/font&gt;&amp;nbsp;&amp;nbsp;(one per entry)' style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3570" y="3841" width="336" height="38" as="geometry"/></mxCell>
        <mxCell id="c599" value="not cached" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3910" y="3841" width="96" height="38" as="geometry"/></mxCell>
        <mxCell id="c600" value="at once; only if the text changed; once" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="4010" y="3841" width="356" height="38" as="geometry"/></mxCell>
        <mxCell id="c601" value='not rewritten: removed at the end, unless&lt;br&gt;&lt;font face="Consolas"&gt;delete-if-not-rewrited&lt;/font&gt; is false' style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="4370" y="3841" width="326" height="38" as="geometry"/></mxCell>
        <mxCell id="c602" value='• "once": writing the same path twice in one run is an error.&lt;br&gt;• Roots of places may not be nested (checked in &lt;font face="Consolas"&gt;add_place&lt;/font&gt;).&lt;br&gt;• "at the end" runs in &lt;font face="Consolas"&gt;do_jobs_at_end&lt;/font&gt;, only after a run that succeeded.&lt;br&gt;• The log folder is opened by Logme from &lt;font face="Consolas"&gt;log.cfg&lt;/font&gt;. It is not a place.&lt;br&gt;• Nothing checks that a relative &lt;font face="Consolas"&gt;..&lt;/font&gt; path stays in its place, so confinement is by construction.' style="whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3570" y="3893" width="1500" height="85" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
