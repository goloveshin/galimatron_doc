        <mxCell id="c248" value="" style="html=1;rounded=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c101" target="c114"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c249" value="" style="html=1;rounded=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c114" target="c127"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c250" value="" style="html=1;rounded=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c127" target="c140"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c251" value="" style="html=1;rounded=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c140" target="c153"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c252" value="" style="html=1;rounded=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c153" target="c166"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c253" value="" style="html=1;rounded=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c166" target="c179"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c254" value="" style="html=1;rounded=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c179" target="c192"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c255" value="" style="html=1;rounded=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c192" target="c205"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c256" value="" style="html=1;rounded=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c205" target="c218"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c257" value="" style="html=1;rounded=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c218" target="c231"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c258" value="" style="html=1;rounded=0;strokeColor=#333333;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="1288" as="sourcePoint"/><mxPoint x="560" y="1338" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c266" value="3  The runtime: after the translator" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#bdbdbd;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="1338" width="5060" height="182" as="geometry"/></mxCell>
        <mxCell id="c259" value='&lt;b&gt;the run succeeded&lt;/b&gt;&lt;br&gt;• &lt;font face="Consolas"&gt;summary_xml.set_result(true)&lt;/font&gt;&lt;br&gt;• &lt;font face="Consolas"&gt;fsd.do_jobs_at_end()&lt;/font&gt;: write the &lt;b&gt;delayed .gal&lt;/b&gt; (normal mode: only the files whose text changed), remove stale files: the &lt;font face="Consolas"&gt;.gal&lt;/font&gt; of&lt;br&gt;&amp;nbsp;&amp;nbsp;aggregates that no longer exist, and generated files of stores with &lt;font face="Consolas"&gt;delete-if-not-rewrited&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="70" y="1390" width="960" height="100" as="geometry"/></mxCell>
        <mxCell id="c260" value='&lt;b&gt;the guard writes the summary&lt;/b&gt;&lt;br&gt;• always, success or failure: &lt;font face="Consolas"&gt;galimatron_summary.xml&lt;/font&gt;&lt;br&gt;• one &lt;font face="Consolas"&gt;&amp;lt;transformation&amp;gt;&lt;/font&gt; per step with its status, produced XML and files, the &lt;font face="Consolas"&gt;user-data-for-info&lt;/font&gt; text, and the error text, if any' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1080" y="1390" width="960" height="100" as="geometry"/></mxCell>
        <mxCell id="c261" value='&lt;b&gt;after &lt;font face="Consolas"&gt;translate()&lt;/font&gt;&lt;/b&gt;&lt;br&gt;• &lt;font face="Consolas"&gt;taskflow.dot&lt;/font&gt; through &lt;font face="Consolas"&gt;notify_taskflow_graph&lt;/font&gt;&lt;br&gt;• private-memory delta logged as &lt;font face="Consolas"&gt;all state: …&lt;/font&gt; (skipped with &lt;font face="Consolas"&gt;committed-report&lt;/font&gt;)&lt;br&gt;• &lt;font face="Consolas"&gt;flush_log()&lt;/font&gt;&lt;br&gt;• exit code: &lt;b&gt;0&lt;/b&gt; after success, &lt;b&gt;1&lt;/b&gt; after any error' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2090" y="1390" width="960" height="100" as="geometry"/></mxCell>
        <mxCell id="c262" value='&lt;b&gt;the run failed&lt;/b&gt;&lt;br&gt;• the exception is a LEAF exception; on a worker it became a &lt;font face="Consolas"&gt;captured_leaf_exception&lt;/font&gt;&lt;br&gt;• the inner &lt;font face="Consolas"&gt;try_catch&lt;/font&gt; copies its text into the summary &lt;font face="Consolas"&gt;&amp;lt;error&amp;gt;&lt;/font&gt;&lt;br&gt;• &lt;font face="Consolas"&gt;do_jobs_at_end&lt;/font&gt; does &lt;b&gt;not&lt;/b&gt; run: delayed &lt;font face="Consolas"&gt;.gal&lt;/font&gt; are dropped, stale files stay&lt;br&gt;• the outer &lt;font face="Consolas"&gt;try_catch&lt;/font&gt; logs the text; the exit code is 1' style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3100" y="1390" width="960" height="100" as="geometry"/></mxCell>
        <mxCell id="c263" value='&lt;b&gt;the program crashed&lt;/b&gt;&lt;br&gt;• &lt;font face="Consolas"&gt;crash.cpp&lt;/font&gt;: &lt;font face="Consolas"&gt;report()&lt;/font&gt; writes &lt;font face="Consolas"&gt;galimatron.crash.log&lt;/font&gt; (&lt;font face="Consolas"&gt;Logme::CrashWrite&lt;/font&gt;, stacktrace) and a summary with &lt;font face="Consolas"&gt;status="crash"&lt;/font&gt;, by direct OS&lt;br&gt;&amp;nbsp;&amp;nbsp;calls&lt;br&gt;• then &lt;font face="Consolas"&gt;TerminateProcess&lt;/font&gt; or &lt;font face="Consolas"&gt;_exit(128 + signal)&lt;/font&gt;: no destructors, so nothing overwrites the crash summary' style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="4110" y="1390" width="960" height="100" as="geometry"/></mxCell>
        <mxCell id="c264" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c259" target="c260"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c265" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c260" target="c261"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c404" value="A  How the list of steps is built" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bdbdbd;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="1580" width="2500" height="748" as="geometry"/></mxCell>
        <mxCell id="c267" value='The list of steps is &lt;b&gt;built&lt;/b&gt;, not written. You configure the interesting steps (the seed). &lt;font face="Consolas"&gt;transform_sequence_builder&lt;/font&gt; inserts the conversions between them, so that each step gets the representation it needs.' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#444444;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="70" y="1624" width="2440" height="20" as="geometry"/></mxCell>
        <mxCell id="c268" value='&lt;b&gt;the seed&lt;/b&gt;: what is configured&lt;br&gt;• &lt;font face="Consolas"&gt;cpp2cpp_validate&lt;/font&gt;&lt;br&gt;• &lt;font face="Consolas"&gt;cpp2cpp_wizard&lt;/font&gt;&lt;br&gt;• only with a language xslt: &lt;font face="Consolas"&gt;cpp2cpp_before_xslt&lt;/font&gt;, your language xslts&lt;br&gt;&amp;nbsp;&amp;nbsp;(&lt;font face="Consolas"&gt;xml2xml&lt;/font&gt;, in config order), &lt;font face="Consolas"&gt;cpp2cpp_after_xslt&lt;/font&gt;&lt;br&gt;• your post xslts (&lt;font face="Consolas"&gt;xml2xml&lt;/font&gt;)&lt;br&gt;They keep their order. A step with &lt;font face="Consolas"&gt;"enable": false&lt;/font&gt; is not in the seed.' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="70" y="1680" width="520" height="122" as="geometry"/></mxCell>
        <mxCell id="c269" value='&lt;b&gt;the catalog&lt;/b&gt;: state transforms, one edge each (domain, state type)&lt;br&gt;• &lt;font face="Consolas"&gt;gal2cpp&lt;/font&gt;&amp;nbsp;&amp;nbsp; LANGUAGE GaL → CPP&lt;br&gt;• &lt;font face="Consolas"&gt;cpp2gal&lt;/font&gt;&amp;nbsp;&amp;nbsp; LANGUAGE CPP → GaL&lt;br&gt;• &lt;font face="Consolas"&gt;cpp2xml&lt;/font&gt;&amp;nbsp;&amp;nbsp; LANGUAGE CPP → XML&lt;br&gt;• &lt;font face="Consolas"&gt;xml2saxon&lt;/font&gt;&amp;nbsp;&amp;nbsp; LANGUAGE XML → SAXON&lt;br&gt;• &lt;font face="Consolas"&gt;xml2cpp&lt;/font&gt;&amp;nbsp;&amp;nbsp; LANGUAGE SAXON → CPP&lt;br&gt;• &lt;font face="Consolas"&gt;cpp2post_cpp&lt;/font&gt;&amp;nbsp;&amp;nbsp; LANGUAGE CPP → POST CPP&lt;br&gt;• &lt;font face="Consolas"&gt;post_cpp2post_xml&lt;/font&gt;&amp;nbsp;&amp;nbsp; POST CPP → POST XML&lt;br&gt;• &lt;font face="Consolas"&gt;post_xml2saxon&lt;/font&gt;&amp;nbsp;&amp;nbsp; POST XML → POST SAXON' style="whiteSpace=wrap;html=1;fillColor=#f2f7fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;dashed=1;dashPattern=5 3" vertex="1" parent="1"><mxGeometry x="630" y="1680" width="760" height="154" as="geometry"/></mxCell>
        <mxCell id="c270" value='&lt;b&gt;builder_t::complete_transform_sequence&lt;/b&gt;&amp;nbsp;&amp;nbsp;(&lt;font face="Consolas"&gt;translator/detail/transform_sequence_builder.cpp&lt;/font&gt;, unit-tested)&lt;br&gt;1. &lt;font face="Consolas"&gt;check_transform_sequence&lt;/font&gt;: LANGUAGE steps first, then POST_LANGUAGE steps. A return to LANGUAGE is an error&lt;br&gt;2. &lt;font face="Consolas"&gt;check_state_transforms&lt;/font&gt;: the catalog must hold the seven edges a run needs&lt;br&gt;3. before each seed step, &lt;font face="Consolas"&gt;ensure_state&lt;/font&gt;: a breadth-first search over the catalog finds the shortest path from the current representation (the language part&lt;br&gt;may not leave LANGUAGE)&lt;br&gt;4. when the language part is done: append &lt;font face="Consolas"&gt;cpp2gal&lt;/font&gt;, unless the last step already is one&lt;br&gt;5. no post xslt: continue to POST XML. A post xslt needs SAXON, so the path ends in &lt;font face="Consolas"&gt;post_xml2saxon&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1430" y="1680" width="1050" height="122" as="geometry"/></mxCell>
        <mxCell id="c271" value="catalog" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c269" target="c270"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c272" value="seed" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="c268" target="c270"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="1656"/><mxPoint x="1640" y="1656"/></Array></mxGeometry></mxCell>
        <mxCell id="c273" value="&lt;b&gt;What comes out&lt;/b&gt;, for four common projects (solid: the seed, dashed: inserted by the builder)" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="70" y="1874" width="1200" height="22" as="geometry"/></mxCell>
        <mxCell id="c274" value="no xslt (7 steps)" style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="70" y="1904" width="270" height="30" as="geometry"/></mxCell>
        <mxCell id="c275" value="gal2cpp" style="whiteSpace=wrap;html=1;fillColor=#f2f7fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;dashed=1;dashPattern=5 3" vertex="1" parent="1"><mxGeometry x="360" y="1904" width="128" height="30" as="geometry"/></mxCell>
        <mxCell id="c276" value="validate" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="494" y="1904" width="128" height="30" as="geometry"/></mxCell>
        <mxCell id="c277" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c275" target="c276"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c278" value="Wizard" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="628" y="1904" width="128" height="30" as="geometry"/></mxCell>
        <mxCell id="c279" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c276" target="c278"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c280" value="cpp2gal" style="whiteSpace=wrap;html=1;fillColor=#f2f7fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;dashed=1;dashPattern=5 3" vertex="1" parent="1"><mxGeometry x="762" y="1904" width="128" height="30" as="geometry"/></mxCell>
        <mxCell id="c281" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c278" target="c280"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c282" value="gal2cpp (skip)" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#aaaaaa;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;dashed=1;dashPattern=5 3" vertex="1" parent="1"><mxGeometry x="896" y="1904" width="128" height="30" as="geometry"/></mxCell>
        <mxCell id="c283" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c280" target="c282"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c284" value="cpp2post_cpp" style="whiteSpace=wrap;html=1;fillColor=#f2f7fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;dashed=1;dashPattern=5 3" vertex="1" parent="1"><mxGeometry x="1030" y="1904" width="128" height="30" as="geometry"/></mxCell>
        <mxCell id="c285" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c282" target="c284"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
