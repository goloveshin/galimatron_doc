        <mxCell id="c288" value="language xslt only (13)" style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="70" y="1944" width="270" height="30" as="geometry"/></mxCell>
