        <mxCell id="c425" value="P" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="1544" y="2486" width="40" height="26" as="geometry"/></mxCell>
        <mxCell id="c426" value='&lt;font face="Consolas"&gt;is_wizard_create_root_aggregate_*&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#eef4fb;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1588" y="2486" width="400" height="26" as="geometry"/></mxCell>
        <mxCell id="c427" value='&lt;font face="Consolas"&gt;apply_wizard_create_root_aggregate&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#eef7ee;strokeColor=#cfcfcf;strokeWidth=1;fontSize=10;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1992" y="2486" width="560" height="26" as="geometry"/></mxCell>
