        <mxCell id="c31" value='&lt;font face="Consolas"&gt;compiled_state_&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="54" y="996" width="222" height="38" as="geometry"/></mxCell>
        <mxCell id="c32" value='&lt;font face="Consolas"&gt;SAXON_SESSION&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="54" y="1038" width="222" height="38" as="geometry"/></mxCell>
        <mxCell id="c33" value='&lt;font face="Consolas"&gt;layout table&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="54" y="1080" width="222" height="38" as="geometry"/></mxCell>
        <mxCell id="c34" value="files written" style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="54" y="1130" width="222" height="58" as="geometry"/></mxCell>
        <mxCell id="c35" value="how it fails" style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="54" y="1196" width="222" height="68" as="geometry"/></mxCell>
        <mxCell id="c36" value='memory of &lt;font face="Consolas"&gt;translator_t&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#777777;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;fontStyle=2;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="54" y="894" width="236" height="18" as="geometry"/></mxCell>
        <mxCell id="c37" value="LANGUAGE domain: GaL is read, checked, edited, written back" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=13;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="316" y="528" width="3460" height="34" as="geometry"/></mxCell>
        <mxCell id="c38" value="LANGUAGE → POST_LANGUAGE (no way back)" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="3792" y="528" width="300" height="34" as="geometry"/></mxCell>
        <mxCell id="c39" value="POST_LANGUAGE domain: compiled picture, XML only" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=13;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="4108" y="528" width="932" height="34" as="geometry"/></mxCell>
        <mxCell id="c40" value="always" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;dashed=1;dashPattern=5 3" vertex="1" parent="1"><mxGeometry x="316" y="570" width="300" height="26" as="geometry"/></mxCell>
        <mxCell id="c41" value="always" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;dashed=1;dashPattern=5 3" vertex="1" parent="1"><mxGeometry x="632" y="570" width="300" height="26" as="geometry"/></mxCell>
        <mxCell id="c42" value="only if a Wizard statement exists" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;dashed=1;dashPattern=5 3" vertex="1" parent="1"><mxGeometry x="948" y="570" width="300" height="26" as="geometry"/></mxCell>
        <mxCell id="c43" value="only when a language xslt is enabled: the seal and the round trip through Saxon" style="whiteSpace=wrap;html=1;fillColor=#fff9e0;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;dashed=1;dashPattern=5 3" vertex="1" parent="1"><mxGeometry x="1264" y="570" width="1880" height="26" as="geometry"/></mxCell>
        <mxCell id="c44" value="always" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;dashed=1;dashPattern=5 3" vertex="1" parent="1"><mxGeometry x="3160" y="570" width="300" height="26" as="geometry"/></mxCell>
        <mxCell id="c45" value="inserted by the builder, skipped at run time" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;dashed=1;dashPattern=5 3" vertex="1" parent="1"><mxGeometry x="3476" y="570" width="300" height="26" as="geometry"/></mxCell>
        <mxCell id="c46" value="always (skipped without a root)" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;dashed=1;dashPattern=5 3" vertex="1" parent="1"><mxGeometry x="3792" y="570" width="300" height="26" as="geometry"/></mxCell>
        <mxCell id="c47" value="always" style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;dashed=1;dashPattern=5 3" vertex="1" parent="1"><mxGeometry x="4108" y="570" width="300" height="26" as="geometry"/></mxCell>
