        <mxCell id="c54" value='• one ANTLR parse per &lt;font face="Consolas"&gt;.gal&lt;/font&gt; file, one &lt;font face="Consolas"&gt;chunk&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;vertex per file&lt;br&gt;• &lt;font face="Consolas"&gt;listener_t&lt;/font&gt; walks the tree, &lt;font face="Consolas"&gt;builder_t&lt;/font&gt; adds&lt;br&gt;&amp;nbsp;&amp;nbsp;vertices and registers them in the holder&lt;br&gt;• keeps source text and comments on the&lt;br&gt;&amp;nbsp;&amp;nbsp;vertices&lt;br&gt;• skipped when &lt;font face="Consolas"&gt;language_state_&lt;/font&gt; is already&lt;br&gt;&amp;nbsp;&amp;nbsp;set' style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cfcfcf;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="316" y="732" width="300" height="170" as="geometry"/></mxCell>
