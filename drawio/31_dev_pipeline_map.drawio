        <mxCell id="c358" value="post_xml2saxon" style="whiteSpace=wrap;html=1;fillColor=#f2f7fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;dashed=1;dashPattern=5 3" vertex="1" parent="1"><mxGeometry x="2102" y="2024" width="128" height="30" as="geometry"/></mxCell>
        <mxCell id="c359" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c356" target="c358"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c360" value="your post xslt" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2236" y="2024" width="128" height="30" as="geometry"/></mxCell>
        <mxCell id="c361" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c358" target="c360"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c362" value='The seed steps are in the Taskflow chain as they are. The Wizard step is skipped at run time when no &lt;font face="Consolas"&gt;Wizard&lt;/font&gt; statement exists. Tests use &lt;font face="Consolas"&gt;prepare_testing_transforms()&lt;/font&gt; instead: the seed is only the steps that a &lt;font face="Consolas"&gt;testing_t&lt;/font&gt; flag switches on, and the builder inserts a conversion only where two seed steps do not meet.' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="70" y="2068" width="2440" height="19" as="geometry"/></mxCell>
        <mxCell id="c403" value='B  The twelve checks of &lt;font face="Consolas"&gt;cpp2cpp_validate&lt;/font&gt;' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bdbdbd;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="2580" y="1580" width="2520" height="748" as="geometry"/></mxCell>
        <mxCell id="c363" value='&lt;font face="Consolas"&gt;cpp2cpp_validate_t::build()&lt;/font&gt; puts twelve checks in a Taskflow &lt;b&gt;subflow&lt;/b&gt;. They run on worker threads. An arrow means "runs after". The edges are those of &lt;font face="Consolas"&gt;intermediate/taskflow.dot&lt;/font&gt;.' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#444444;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="2610" y="1628" width="2460" height="20" as="geometry"/></mxCell>
