<mxfile host="app.diagrams.net">
  <diagram name="31_dev_pipeline_map" id="31_dev_pipeline_map">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5140" pageHeight="4135" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="Galimatron: one run, step by step" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=28;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1800" height="41" as="geometry"/></mxCell>
        <mxCell id="c3" value='What &lt;font face="Consolas"&gt;galimatron --gal-config-file gal.cfg --log-config-file log.cfg&lt;/font&gt; does, for a project that has a Wizard command, a language xslt and a post xslt. Read it top to bottom: the runtime wraps the run, the translator runs fifteen steps one after another, and the panels below open the steps that hide the most.' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=13;fontColor=#555555;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="40" y="66" width="3200" height="22" as="geometry"/></mxCell>
        <mxCell id="c4" value="built-in step" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="40" y="128" width="150" height="26" as="geometry"/></mxCell>
        <mxCell id="c5" value="your xslt" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="206" y="128" width="150" height="26" as="geometry"/></mxCell>
        <mxCell id="c6" value="state in memory" style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="372" y="128" width="150" height="26" as="geometry"/></mxCell>
        <mxCell id="c7" value="file on disk" style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="538" y="128" width="150" height="26" as="geometry"/></mxCell>
        <mxCell id="c8" value="saxon" style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="704" y="128" width="150" height="26" as="geometry"/></mxCell>
        <mxCell id="c9" value="failure" style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="870" y="128" width="150" height="26" as="geometry"/></mxCell>
        <mxCell id="c10" value='Source code names are in &lt;font face="Consolas"&gt;code font&lt;/font&gt;. Directories are relative to &lt;font face="Consolas"&gt;galimatron/translator_library/&lt;/font&gt; or &lt;font face="Consolas"&gt;galimatron/runtime_library/&lt;/font&gt;.' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#666666;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="1046" y="131" width="1500" height="19" as="geometry"/></mxCell>
        <mxCell id="c20" value="1  The runtime: before the translator  (galimatron/executable, executable_library, runtime_library)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fcfcfb;strokeColor=#bdbdbd;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="5060" height="236" as="geometry"/></mxCell>
        <mxCell id="c11" value='&lt;b&gt;command line&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;galimatron --gal-config-file gal.cfg --log-config-file log.cfg&lt;/font&gt;&lt;br&gt;&lt;font face="Consolas"&gt;executable/main.cpp&lt;/font&gt; parses the arguments (&lt;font face="Consolas"&gt;executable_library/command_line.cpp&lt;/font&gt;, Boost.Program_options). &lt;font face="Consolas"&gt;--help&lt;/font&gt; prints and exits.' style="whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="70" y="242" width="960" height="154" as="geometry"/></mxCell>
        <mxCell id="c12" value='&lt;b&gt;rt::translate(args)&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;runtime_library/translate/detail/translate.cpp&lt;/font&gt;&lt;br&gt;• &lt;font face="Consolas"&gt;crash::install()&lt;/font&gt;: SEH filter or signals&lt;br&gt;• log to the console until log.cfg is read&lt;br&gt;• &lt;font face="Consolas"&gt;apply_log_config&lt;/font&gt;, then &lt;font face="Consolas"&gt;crash::arm_log()&lt;/font&gt;: name a crash log beside the log&lt;br&gt;• read gal.cfg: three passes, paths made absolute&lt;br&gt;• set the path report (&lt;font face="Consolas"&gt;committed-report&lt;/font&gt;)&lt;br&gt;• &lt;b&gt;outer&lt;/b&gt; &lt;font face="Consolas"&gt;leaf_spy::try_catch&lt;/font&gt;: prints and logs every error' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1080" y="242" width="960" height="154" as="geometry"/></mxCell>
        <mxCell id="c13" value='&lt;b&gt;translate_by_config&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;translate/detail/translate_by_config.cpp&lt;/font&gt;&lt;br&gt;• &lt;font face="Consolas"&gt;filesystem_decorator_t&lt;/font&gt; with &lt;b&gt;places&lt;/b&gt;: the .gal place(s), the intermediate place, one place per &lt;font face="Consolas"&gt;other-files&lt;/font&gt; store (panel I)&lt;br&gt;• &lt;font face="Consolas"&gt;summary builder&lt;/font&gt; and a scope guard that always writes &lt;font face="Consolas"&gt;galimatron_summary.xml&lt;/font&gt;&lt;br&gt;• &lt;font face="Consolas"&gt;process_result&lt;/font&gt;: routes the output of every step to a place' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2090" y="242" width="960" height="154" as="geometry"/></mxCell>
        <mxCell id="c14" value='&lt;b&gt;start of the run&lt;/b&gt;&lt;br&gt;• &lt;font face="Consolas"&gt;fsd.do_jobs_at_begin()&lt;/font&gt;: create folders, delete the files of places marked &lt;font face="Consolas"&gt;at_begin&lt;/font&gt; (the intermediate folder; the output .gal in&lt;br&gt;&amp;nbsp;&amp;nbsp;separate mode)&lt;br&gt;• &lt;font face="Consolas"&gt;crash::arm_summary()&lt;/font&gt;&lt;br&gt;• add six directory &lt;font face="Consolas"&gt;xsl:param&lt;/font&gt;s to every enabled user transform&lt;br&gt;• read the &lt;font face="Consolas"&gt;.gal&lt;/font&gt; files lazily from the input place, read &lt;font face="Consolas"&gt;gal.version&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="3100" y="242" width="960" height="154" as="geometry"/></mxCell>
        <mxCell id="c15" value='&lt;b&gt;translator::translate(config)&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;translator/detail/translate.cpp&lt;/font&gt;&lt;br&gt;• &lt;font face="Consolas"&gt;prepare_transforms()&lt;/font&gt;: builds the list of steps (panel A)&lt;br&gt;• one Taskflow task per step, chained with &lt;font face="Consolas"&gt;precede&lt;/font&gt;: strictly one after another&lt;br&gt;• one static &lt;font face="Consolas"&gt;tf::Executor&lt;/font&gt; for the process (Saxon attaches a Graal thread to each worker)&lt;br&gt;• &lt;font face="Consolas"&gt;executor().run(taskflow).get()&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=13;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="4110" y="242" width="960" height="154" as="geometry"/></mxCell>
        <mxCell id="c16" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c17" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c18" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c19" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c21" value="" style="html=1;rounded=0;strokeColor=#333333;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="4590" y="426" as="sourcePoint"/><mxPoint x="4590" y="476" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c22" value="2  The translator: fifteen steps, in the order of the Taskflow chain  (galimatron/translator_library)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bdbdbd;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="40" y="476" width="5060" height="812" as="geometry"/></mxCell>
        <mxCell id="c23" value="domain" style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="54" y="528" width="222" height="34" as="geometry"/></mxCell>
        <mxCell id="c24" value="present when" style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="54" y="570" width="222" height="26" as="geometry"/></mxCell>
        <mxCell id="c25" value="step" style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="54" y="604" width="222" height="40" as="geometry"/></mxCell>
        <mxCell id="c26" value="state type in → out" style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="54" y="650" width="222" height="30" as="geometry"/></mxCell>
        <mxCell id="c27" value="where it lives" style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="54" y="686" width="222" height="40" as="geometry"/></mxCell>
        <mxCell id="c28" value="what it does" style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;fontStyle=1" vertex="1" parent="1"><mxGeometry x="54" y="732" width="222" height="170" as="geometry"/></mxCell>
