        <mxCell id="a2" value='version 2  (new, open)&lt;br&gt;field important&lt;br&gt;&amp;nbsp;&amp;nbsp;{ "long", "price" };' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
