          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="n" value="An xslt does not rewrite a closed version. Galimatron compares the text before and after. Where the xslt changed a value that belongs to a closed version, the change moves to the first open version after it; the version is added when it does not exist. The hash of version 1 stays true." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;" vertex="1" parent="1">
