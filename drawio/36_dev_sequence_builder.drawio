<mxfile host="app.diagrams.net">
  <diagram name="36_dev_sequence_builder" id="36_dev_sequence_builder">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="The list of steps is built, not written" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=20;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1500" height="31" as="geometry"/></mxCell>
        <mxCell id="c3" value='&lt;b&gt;the seed&lt;/b&gt;: what is configured&lt;br&gt;• &lt;font face="Consolas"&gt;cpp2cpp_validate&lt;/font&gt;&lt;br&gt;• &lt;font face="Consolas"&gt;cpp2cpp_wizard&lt;/font&gt;&lt;br&gt;• with a language xslt: &lt;font face="Consolas"&gt;cpp2cpp_before_xslt&lt;/font&gt;, your xslts, &lt;font face="Consolas"&gt;cpp2cpp_after_xslt&lt;/font&gt;&lt;br&gt;• your post xslts' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="90" width="520" height="190" as="geometry"/></mxCell>
        <mxCell id="c4" value='&lt;b&gt;the catalog&lt;/b&gt;: eight edges (domain, state)&lt;br&gt;• &lt;font face="Consolas"&gt;gal2cpp&lt;/font&gt;&amp;nbsp;&amp;nbsp;GaL → CPP&lt;br&gt;• &lt;font face="Consolas"&gt;cpp2gal&lt;/font&gt;&amp;nbsp;&amp;nbsp;CPP → GaL&lt;br&gt;• &lt;font face="Consolas"&gt;cpp2xml&lt;/font&gt;&amp;nbsp;&amp;nbsp;CPP → XML&lt;br&gt;• &lt;font face="Consolas"&gt;xml2saxon&lt;/font&gt;&amp;nbsp;&amp;nbsp;XML → SAXON&lt;br&gt;• &lt;font face="Consolas"&gt;xml2cpp&lt;/font&gt;&amp;nbsp;&amp;nbsp;SAXON → CPP&lt;br&gt;• &lt;font face="Consolas"&gt;cpp2post_cpp&lt;/font&gt;&amp;nbsp;&amp;nbsp;LANGUAGE CPP → POST CPP&lt;br&gt;• &lt;font face="Consolas"&gt;post_cpp2post_xml&lt;/font&gt;&amp;nbsp;&amp;nbsp;POST CPP → POST XML&lt;br&gt;• &lt;font face="Consolas"&gt;post_xml2saxon&lt;/font&gt;&amp;nbsp;&amp;nbsp;POST XML → POST SAXON' style="whiteSpace=wrap;html=1;fillColor=#f2f7fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;dashed=1;dashPattern=5 3" vertex="1" parent="1"><mxGeometry x="600" y="90" width="640" height="190" as="geometry"/></mxCell>
        <mxCell id="c5" value='&lt;b&gt;builder_t&lt;/b&gt;&lt;br&gt;1. check the domain order (LANGUAGE, then POST_LANGUAGE)&lt;br&gt;2. check the catalog has the seven edges&lt;br&gt;3. before each seed step: &lt;b&gt;breadth-first shortest path&lt;/b&gt; over the catalog, language part stays in LANGUAGE&lt;br&gt;4. language part done: append &lt;font face="Consolas"&gt;cpp2gal&lt;/font&gt; unless the last step is one&lt;br&gt;5. no post step: path to POST XML; a post xslt: path to POST SAXON' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1290" y="90" width="980" height="190" as="geometry"/></mxCell>
        <mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.1;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="60"/><mxPoint x="1388" y="60"/></Array></mxGeometry></mxCell>
