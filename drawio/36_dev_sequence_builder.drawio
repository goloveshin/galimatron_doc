        <mxCell id="c93" value="post_xml2saxon" style="whiteSpace=wrap;html=1;fillColor=#f2f7fc;strokeColor=#6c8ebf;strokeWidth=1.5;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8;dashed=1;dashPattern=5 3" vertex="1" parent="1"><mxGeometry x="2016" y="504" width="126" height="34" as="geometry"/></mxCell>
        <mxCell id="c94" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c91" target="c93"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c95" value="your post xslt" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.5;fontSize=10;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="2148" y="504" width="126" height="34" as="geometry"/></mxCell>
        <mxCell id="c96" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c93" target="c95"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c97" value='The second &lt;font face="Consolas"&gt;gal2cpp&lt;/font&gt; is the way from GaL back to CPP for the post part. It is skipped at run time because &lt;font face="Consolas"&gt;language_state_&lt;/font&gt; is set.&lt;br&gt;The testing path (&lt;font face="Consolas"&gt;prepare_testing_transforms&lt;/font&gt;) runs the builder with &lt;font face="Consolas"&gt;finish_sequence = false&lt;/font&gt;: the seed is only the flagged steps, and an edge is inserted only where two seed steps do not meet.' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=11;fontColor=#555555;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="30" y="562" width="2200" height="34" as="geometry"/></mxCell>
        <mxCell id="c98" value='&lt;b&gt;Domains&lt;/b&gt;: &lt;font face="Consolas"&gt;LANGUAGE&lt;/font&gt; (the language graph) → &lt;font face="Consolas"&gt;POST_LANGUAGE&lt;/font&gt; (the compiled view); &lt;font face="Consolas"&gt;cpp2post_cpp&lt;/font&gt; is the one edge that changes the domain, and there is no way back.&lt;br&gt;&lt;b&gt;State types&lt;/b&gt;: &lt;font face="Consolas"&gt;GaL&lt;/font&gt; text · &lt;font face="Consolas"&gt;CPP&lt;/font&gt; the graph in memory · &lt;font face="Consolas"&gt;XML&lt;/font&gt; pugixml text · &lt;font face="Consolas"&gt;SAXON&lt;/font&gt; the document held for an xslt.' style="whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="632" width="2240" height="64" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
