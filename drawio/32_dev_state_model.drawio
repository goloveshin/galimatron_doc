        <mxCell id="c2" value="The state of the translator" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=20;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1200" height="31" as="geometry"/></mxCell>
        <mxCell id="c3" value="The graph holds the truth. The containers are indexes over it. The compiled part is derived and can be dropped at any time." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1700" height="20" as="geometry"/></mxCell>
