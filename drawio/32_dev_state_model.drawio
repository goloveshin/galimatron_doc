        <mxCell id="c28" value='The containers are kept in sync by the builder and by explicit calls: &lt;font face="Consolas"&gt;refresh_live_and_hashed&lt;/font&gt;,&lt;br&gt;&lt;font face="Consolas"&gt;note_version_child&lt;/font&gt;, &lt;font face="Consolas"&gt;forget_version_child&lt;/font&gt;, &lt;font face="Consolas"&gt;rebind_version_definitions&lt;/font&gt;, &lt;font face="Consolas"&gt;refresh_version_records&lt;/font&gt;.' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=10;fontColor=#555555;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="750" y="690" width="580" height="32" as="geometry"/></mxCell>
