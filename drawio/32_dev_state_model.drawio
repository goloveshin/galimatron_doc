        <mxCell id="c14" value='language_part_t   (&lt;font face="Consolas"&gt;state/holder/holder.hpp&lt;/font&gt;)' style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fbfdf9;strokeColor=#82b366;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontSize=14;fontStyle=1;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="730" y="110" width="620" height="700" as="geometry"/></mxCell>
        <mxCell id="c15" value='&lt;b&gt;graph_t&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;boost::adjacency_list&amp;lt;listS, containerS, bidirectionalS, vertex_t&amp;gt;&lt;/font&gt;&lt;br&gt;vertices live in a &lt;font face="Consolas"&gt;multi_index_container&lt;/font&gt;: random access, by &lt;font face="Consolas"&gt;entity_type&lt;/font&gt;, by &amp;#96;(vd_parent,&lt;br&gt;entity_type)&amp;#96;&lt;br&gt;&lt;font face="Consolas"&gt;vertex_t {entity_type, entity, location, vd_parent, vd_self, user_comments, user_formatting}&lt;/font&gt;&lt;br&gt;edges parent → child; &lt;b&gt;vertices are never removed&lt;/b&gt;, only detached' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="750" y="160" width="580" height="118" as="geometry"/></mxCell>
