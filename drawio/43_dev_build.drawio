<mxfile host="app.diagrams.net">
  <diagram name="43_dev_build" id="43_dev_build">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="From source to installer" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=20;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1500" height="31" as="geometry"/></mxCell>
        <mxCell id="c3" value='&lt;b&gt;configure&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;cmake -S . -B build -G Ninja&lt;/font&gt;&lt;br&gt;&lt;font face="Consolas"&gt;dependencies.cmake&lt;/font&gt;: FetchContent for Boost, logme, ANTLR (+ jar), range-v3, pugixml, nlohmann_json, inja, alpaca, doctest,&lt;br&gt;magic_enum, Taskflow, leaf_spy, multi_index_lookup; SaxonC-HE from &lt;font face="Consolas"&gt;externals/Saxon&lt;/font&gt;&lt;br&gt;patches: ANTLR, doctest, inja, Saxon cmake' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="90" width="760" height="210" as="geometry"/></mxCell>
        <mxCell id="c4" value='&lt;b&gt;build&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;global_pch_library&lt;/font&gt; owns the PCH&lt;br&gt;ANTLR generates the lexer and parser&lt;br&gt;libraries: global → common → translator → runtime → executable&lt;br&gt;tests and examples' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="830" y="90" width="560" height="210" as="geometry"/></mxCell>
        <mxCell id="c5" value='&lt;b&gt;test&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;run_tests&lt;/font&gt;&lt;br&gt;(three executables, &lt;font face="Consolas"&gt;bin/&lt;/font&gt; as the working directory)' style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1430" y="90" width="380" height="210" as="geometry"/></mxCell>
        <mxCell id="c6" value='&lt;b&gt;package&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;package&lt;/font&gt; target&lt;br&gt;Windows: ZIP, NSIS&lt;br&gt;Linux: TGZ, DEB, RPM' style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1850" y="90" width="360" height="210" as="geometry"/></mxCell>
        <mxCell id="c7" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c8" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c9" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c10" value='&lt;b&gt;what the installer holds&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;bin/&lt;/font&gt;: &lt;font face="Consolas"&gt;galimatron&lt;/font&gt;, &lt;font face="Consolas"&gt;saxonc-he&lt;/font&gt;, &lt;font face="Consolas"&gt;saxonc-core-he&lt;/font&gt; (and the MSVC runtime on Windows)&lt;br&gt;&lt;font face="Consolas"&gt;share/galimatron/xslt/gal-functions.xsl&lt;/font&gt; · &lt;font face="Consolas"&gt;share/galimatron/catalog.xml&lt;/font&gt; (maps the GitHub URL of &lt;font face="Consolas"&gt;gal-functions.xsl&lt;/font&gt; to that file)&lt;br&gt;&lt;font face="Consolas"&gt;share/doc/galimatron/&lt;/font&gt;: &lt;font face="Consolas"&gt;LICENSE&lt;/font&gt;, &lt;font face="Consolas"&gt;THIRD_PARTY_NOTICES.md&lt;/font&gt;, &lt;font face="Consolas"&gt;third_party_licenses/&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="340" width="1060" height="130" as="geometry"/></mxCell>
        <mxCell id="c11" value='&lt;b&gt;CI&lt;/b&gt; (&lt;font face="Consolas"&gt;.github/workflows&lt;/font&gt;)&lt;br&gt;Windows: MSVC Debug, MSVC Release (+ package)&lt;br&gt;Linux: GCC Debug, GCC Release (+ package), Clang Debug, Clang Release&lt;br&gt;each: configure → build → &lt;font face="Consolas"&gt;run_tests&lt;/font&gt; → (package) → upload artifacts' style="whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1130" y="340" width="1040" height="130" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;release&lt;/b&gt;: &lt;font face=&quot;Consolas&quot;&gt;scripts/release.py&lt;/font&gt; copies this repository into the checkout of the public one, minus &lt;font face=&quot;Consolas&quot;&gt;.cursor/rules&lt;/font&gt;, &lt;font face=&quot;Consolas&quot;&gt;.vscode&lt;/font&gt;, the &lt;font face=&quot;Consolas&quot;&gt;TODO*.txt&lt;/font&gt; files, the benchmark's outputs and the build products.&lt;br&gt;&lt;b&gt;mind&lt;/b&gt;: the Saxon core binary is Release-only (a Debug build uses it); the CRT is dynamic; after you add or remove a source file, run CMake again." style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="500" width="2140" height="84" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
