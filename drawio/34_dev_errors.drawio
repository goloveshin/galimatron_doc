<mxfile host="app.diagrams.net">
  <diagram name="34_dev_errors" id="34_dev_errors">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="The path of an error" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=20;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1200" height="31" as="geometry"/></mxCell>
        <mxCell id="c3" value='&lt;b&gt;throw site&lt;/b&gt;&lt;br&gt;&amp;#96;leaf::throw_exception(domain, subdomain, e_what_info, [code],&lt;br&gt;...)&amp;#96;&lt;br&gt;guards: &lt;font face="Consolas"&gt;augment_domain&lt;/font&gt;, &lt;font face="Consolas"&gt;augment_path&lt;/font&gt;, &lt;font face="Consolas"&gt;augment_aggregate&lt;/font&gt;,&lt;br&gt;&lt;font face="Consolas"&gt;augment_version&lt;/font&gt;, &lt;font face="Consolas"&gt;augment_where&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="100" width="400" height="120" as="geometry"/></mxCell>
        <mxCell id="c4" value='&lt;b&gt;on the main thread&lt;/b&gt;&lt;br&gt;the exception travels to the nearest &lt;font face="Consolas"&gt;try_catch&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="520" y="90" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="c5" value='&lt;b&gt;on a Taskflow worker&lt;/b&gt; (no LEAF context)&lt;br&gt;&lt;font face="Consolas"&gt;capture_or_rethrow&lt;/font&gt; → &lt;font face="Consolas"&gt;leaf::try_capture_all&lt;/font&gt; → throws&lt;br&gt;&lt;font face="Consolas"&gt;captured_leaf_exception&lt;/font&gt;;&lt;br&gt;&lt;font face="Consolas"&gt;subflow.join()&lt;/font&gt; / &lt;font face="Consolas"&gt;future.get()&lt;/font&gt; rethrows it on the caller' style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="520" y="190" width="420" height="110" as="geometry"/></mxCell>
        <mxCell id="c6" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c3" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c8" value='&lt;b&gt;inner catch&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;translate_by_config&lt;/font&gt;&lt;br&gt;&lt;font face="Consolas"&gt;runtime::try_catch&lt;/font&gt;, &lt;font face="Consolas"&gt;is_throw_out = true&lt;/font&gt;&lt;br&gt;&lt;font face="Consolas"&gt;leaf_spy&lt;/font&gt; loads every domain, subdomain, enum and payload and prints &lt;font face="Consolas"&gt;Exception details:&lt;/font&gt;&lt;br&gt;&lt;font face="Consolas"&gt;notify_printed&lt;/font&gt; → the summary &lt;font face="Consolas"&gt;&amp;lt;error&amp;gt;&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1040" y="140" width="600" height="130" as="geometry"/></mxCell>
        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c4" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c5" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c11" value='&lt;b&gt;outer catch&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;translate_impl_t::translate&lt;/font&gt;&lt;br&gt;the same wrapper: the text is logged with &lt;font face="Consolas"&gt;fLogmeE&lt;/font&gt;; the result is 1&lt;br&gt;&lt;font face="Consolas"&gt;is_throw_out = is_testing_mode&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1040" y="330" width="600" height="100" as="geometry"/></mxCell>
        <mxCell id="c12" value="rethrow" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c8" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c13" value='&lt;b&gt;after the catches&lt;/b&gt;: the scope guard writes &lt;font face="Consolas"&gt;galimatron_summary.xml&lt;/font&gt; (&lt;font face="Consolas"&gt;status="fail"&lt;/font&gt;), &lt;font face="Consolas"&gt;flush_log()&lt;/font&gt;,&lt;br&gt;exit code 1. &lt;font face="Consolas"&gt;do_jobs_at_end&lt;/font&gt; did not run.' style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1040" y="470" width="600" height="70" as="geometry"/></mxCell>
        <mxCell id="c14" value='&lt;b&gt;in a test&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;print_leaf_exception(func, handlers...)&lt;/font&gt; wraps the call in&lt;br&gt;&lt;font face="Consolas"&gt;runtime::try_catch&lt;/font&gt;; the handler checks &lt;font face="Consolas"&gt;domain&lt;/font&gt;, &lt;font face="Consolas"&gt;subdomain&lt;/font&gt;, &lt;font face="Consolas"&gt;e_what_info&lt;/font&gt;,&lt;br&gt;path, aggregate, version' style="whiteSpace=wrap;html=1;fillColor=#f2f2f2;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="520" y="340" width="460" height="110" as="geometry"/></mxCell>
        <mxCell id="c15" value='&lt;b&gt;not LEAF&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;antlr4::ParseCancellationException&lt;/font&gt; (syntax; printed by a &lt;font face="Consolas"&gt;dynamic_cast&lt;/font&gt;)&lt;br&gt;&lt;font face="Consolas"&gt;std::runtime_error&lt;/font&gt; (&lt;font face="Consolas"&gt;apply_log_config&lt;/font&gt;, &lt;font face="Consolas"&gt;merge_paths&lt;/font&gt;)&lt;br&gt;Both print &lt;font face="Consolas"&gt;NO DOMAIN-SPECIFIC EXCEPTION CATEGORY MATCHED&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="260" width="440" height="120" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b&gt;the path in the text&lt;/b&gt; is spelled from copies in &lt;font face=&quot;Consolas&quot;&gt;e_path_info&lt;/font&gt; (&lt;font face=&quot;Consolas&quot;&gt;committed_report&lt;/font&gt;, &lt;font face=&quot;Consolas&quot;&gt;config_dir&lt;/font&gt;): the run's path report may be gone when the text is built.&lt;br&gt;Every path in a message goes through &lt;font face=&quot;Consolas&quot;&gt;report_path&lt;/font&gt;." style="whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="500" width="940" height="64" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
