  <diagram name="40_dev_xml_roundtrip" id="40_dev_xml_roundtrip">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="The XML round trip" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=20;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1500" height="31" as="geometry"/></mxCell>
        <mxCell id="c3" value='&lt;b&gt;language_part_t&lt;/b&gt;&lt;br&gt;vertices keep &lt;font face="Consolas"&gt;user_formatting&lt;/font&gt; and &lt;font face="Consolas"&gt;user_comments&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="90" width="340" height="130" as="geometry"/></mxCell>
        <mxCell id="c4" value='&lt;b&gt;cpp2xml::translate&lt;/b&gt;&lt;br&gt;clear the layout table; for each vertex with text or comments write&lt;br&gt;&lt;font face="Consolas"&gt;layout-mark="N"&lt;/font&gt; and store {text, comments, fingerprint}' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="410" y="90" width="460" height="130" as="geometry"/></mxCell>
        <mxCell id="c5" value='&lt;b&gt;language XML&lt;/b&gt;&lt;br&gt;printed, then parsed into Saxon by &lt;font face="Consolas"&gt;xml2saxon&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="910" y="90" width="340" height="130" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;your xslt&lt;/b&gt;&lt;br&gt;changes, adds, deletes" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1290" y="90" width="300" height="130" as="geometry"/></mxCell>
        <mxCell id="c7" value='&lt;b&gt;xml2cpp_saxon&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;builder_t&lt;/font&gt; builds a new graph; &lt;font face="Consolas"&gt;restore_layout&lt;/font&gt;: comments always; text only if the&lt;br&gt;fingerprint is unchanged' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1630" y="90" width="520" height="130" as="geometry"/></mxCell>
        <mxCell id="c8" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c9" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c10" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c11" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c12" value='&lt;b&gt;language XML&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;&amp;lt;galimatron&amp;gt;&amp;lt;language&amp;gt;&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="270" width="1140" height="32" as="geometry"/></mxCell>
        <mxCell id="c13" value='&lt;b&gt;compiled XML&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;&amp;lt;galimatron&amp;gt;&amp;lt;compiled&amp;gt;&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1;fontSize=12;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1210" y="270" width="1140" height="32" as="geometry"/></mxCell>
        <mxCell id="c14" value='&lt;font face="Consolas"&gt;&amp;lt;chunk&amp;gt;&amp;lt;location&amp;gt;&lt;/font&gt; per file&lt;br&gt;&lt;font face="Consolas"&gt;&amp;lt;root-aggregate&amp;gt;&lt;/font&gt; / &lt;font face="Consolas"&gt;&amp;lt;aggregate&amp;gt;&lt;/font&gt; with declarations and definitions&lt;br&gt;&lt;font face="Consolas"&gt;&amp;lt;tag index name mode layout-mark&amp;gt;&lt;/font&gt; with &lt;font face="Consolas"&gt;&amp;lt;label-refs&amp;gt;&lt;/font&gt; and &lt;font face="Consolas"&gt;&amp;lt;values&amp;gt;&lt;/font&gt; (&lt;font face="Consolas"&gt;template-engine&lt;/font&gt;)&lt;br&gt;&lt;font face="Consolas"&gt;&amp;lt;label&amp;gt;&lt;/font&gt; static or dynamic · &lt;font face="Consolas"&gt;&amp;lt;ordering&amp;gt;&lt;/font&gt; · &lt;font face="Consolas"&gt;&amp;lt;delete&amp;gt;&lt;/font&gt;&lt;br&gt;Wizard marks: &lt;font face="Consolas"&gt;&amp;lt;dynamic wizard="..."/&amp;gt;&lt;/font&gt;, &lt;font face="Consolas"&gt;&amp;lt;dynamic labelname="value"/&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font face="Consolas"&gt;&amp;lt;string-delimiters&amp;gt;&lt;/font&gt; · &lt;font face="Consolas"&gt;&amp;lt;history&amp;gt;&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="306" width="1140" height="170" as="geometry"/></mxCell>
        <mxCell id="c15" value='the same skeleton; each version lists only the &lt;b&gt;effective tags&lt;/b&gt;&lt;br&gt;a tag always has its name&lt;br&gt;labels are &lt;b&gt;attributes on &lt;font face="Consolas"&gt;&amp;lt;value&amp;gt;&lt;/font&gt;&lt;/b&gt;: &lt;font face="Consolas"&gt;&amp;lt;value index="0" field="type"&amp;gt;&lt;/font&gt;&lt;br&gt;&lt;font face="Consolas"&gt;&amp;lt;string&amp;gt;&lt;/font&gt; holds the &lt;b&gt;rendered&lt;/b&gt; text&lt;br&gt;&lt;font face="Consolas"&gt;&amp;lt;orderings&amp;gt;&amp;lt;ordering name index="position"/&amp;gt;&lt;/font&gt; per aggregate version&lt;br&gt;no Wizard marks · &lt;font face="Consolas"&gt;&amp;lt;history&amp;gt;&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#fff8ee;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1210" y="306" width="1140" height="170" as="geometry"/></mxCell>
        <mxCell id="c16" value='&lt;b&gt;fingerprint&lt;/b&gt;: element name, attributes except &lt;font face="Consolas"&gt;layout-mark&lt;/font&gt; (sorted), children, non-blank text. Two implementations (&lt;font face="Consolas"&gt;layout::fingerprint&lt;/font&gt; on pugixml, &lt;font face="Consolas"&gt;fingerprint&lt;/font&gt; on &lt;font face="Consolas"&gt;node_t&lt;/font&gt;) must produce the same text.&lt;br&gt;&lt;b&gt;the table&lt;/b&gt; lives in &lt;font face="Consolas"&gt;any_transform_states_&lt;/font&gt; for the whole run and is cleared and refilled by every print of XML; it matters between the print in &lt;font face="Consolas"&gt;xml2saxon&lt;/font&gt; and the read in &lt;font face="Consolas"&gt;xml2cpp&lt;/font&gt;.' style="whiteSpace=wrap;html=1;fillColor=#fbfbfb;strokeColor=#cccccc;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="510" width="2320" height="80" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
