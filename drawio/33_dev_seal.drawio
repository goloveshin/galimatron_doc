<mxfile host="app.diagrams.net">
  <diagram name="33_dev_seal" id="33_dev_seal">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="The seal: reassign_sealed_edits(before, after)" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=20;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1200" height="31" as="geometry"/></mxCell>
        <mxCell id="c3" value='Runs in &lt;font face="Consolas"&gt;cpp2cpp_after_xslt&lt;/font&gt;, only when a language xslt is enabled. Left: the ways out that return &lt;font face="Consolas"&gt;after&lt;/font&gt; as it is.' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1500" height="20" as="geometry"/></mxCell>
        <mxCell id="c4" value='a root on both sides, and a hashed version (&lt;font face="Consolas"&gt;last_hashed&lt;/font&gt;)?' style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;shape=rhombus;perimeter=rhombusPerimeter" vertex="1" parent="1"><mxGeometry x="560" y="110" width="480" height="76" as="geometry"/></mxCell>
        <mxCell id="c5" value='&lt;font face="Consolas"&gt;refresh_version_records()&lt;/font&gt; on both: rebuild every &lt;font face="Consolas"&gt;definition_payload&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="520" y="220" width="560" height="25" as="geometry"/></mxCell>
        <mxCell id="c6" value='&lt;font face="Consolas"&gt;reject_sealed_shape&lt;/font&gt;: an aggregate of &lt;font face="Consolas"&gt;before&lt;/font&gt; is missing in &lt;font face="Consolas"&gt;after&lt;/font&gt;, or a version was&lt;br&gt;inserted into the sealed range' style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="520" y="281" width="560" height="40" as="geometry"/></mxCell>
        <mxCell id="c7" value='&lt;font face="Consolas"&gt;sealed_history_differs&lt;/font&gt;: declaration, hash, comment, status or payload of a&lt;br&gt;sealed version?' style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;shape=rhombus;perimeter=rhombusPerimeter" vertex="1" parent="1"><mxGeometry x="560" y="357" width="480" height="76" as="geometry"/></mxCell>
        <mxCell id="c8" value='&lt;font face="Consolas"&gt;effective_edits&lt;/font&gt;: compile both graphs, diff the &lt;b&gt;effective tags&lt;/b&gt; of the last sealed version:&lt;br&gt;&lt;font face="Consolas"&gt;REASSIGN&lt;/font&gt; or &lt;font face="Consolas"&gt;DELETE_TAG&lt;/font&gt; per aggregate' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="520" y="467" width="560" height="40" as="geometry"/></mxCell>
        <mxCell id="c9" value='only &lt;font face="Consolas"&gt;REASSIGN&lt;/font&gt; of tags the wizard copied (&lt;font face="Consolas"&gt;created_by_wizard&lt;/font&gt;, dynamic label)?' style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;shape=rhombus;perimeter=rhombusPerimeter" vertex="1" parent="1"><mxGeometry x="560" y="543" width="480" height="76" as="geometry"/></mxCell>
        <mxCell id="c10" value='&lt;font face="Consolas"&gt;restore_sealed_history&lt;/font&gt;: every sealed version of &lt;font face="Consolas"&gt;after&lt;/font&gt; becomes a clone of &lt;font face="Consolas"&gt;before&lt;/font&gt;&lt;br&gt;(declaration fields, presentation, children)' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="520" y="653" width="560" height="40" as="geometry"/></mxCell>
        <mxCell id="c11" value="any effective edits left?" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;shape=rhombus;perimeter=rhombusPerimeter" vertex="1" parent="1"><mxGeometry x="560" y="729" width="480" height="76" as="geometry"/></mxCell>
        <mxCell id="c12" value='&lt;font face="Consolas"&gt;destination_version&lt;/font&gt;: the first open version after &lt;font face="Consolas"&gt;last_sealed&lt;/font&gt;, or &lt;font face="Consolas"&gt;open_next_version&lt;/font&gt; makes&lt;br&gt;one for every live aggregate' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="520" y="839" width="560" height="40" as="geometry"/></mxCell>
        <mxCell id="c13" value='&lt;font face="Consolas"&gt;write_edits&lt;/font&gt;: clone each changed tag into it (&lt;font face="Consolas"&gt;created_by_wizard&lt;/font&gt;), or write &lt;font face="Consolas"&gt;delete name;&lt;/font&gt;. A&lt;br&gt;tag already named there is left alone' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="520" y="915" width="560" height="40" as="geometry"/></mxCell>
        <mxCell id="c14" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c15" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c16" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c17" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c18" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c19" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c20" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c21" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c22" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c23" value='&lt;b&gt;return &lt;font face="Consolas"&gt;after&lt;/font&gt;&lt;/b&gt;&lt;br&gt;nothing sealed, or nothing changed' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="60" y="280" width="330" height="56" as="geometry"/></mxCell>
        <mxCell id="c24" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="c4" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c25" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="c7" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c26" value='&lt;b&gt;return &lt;font face="Consolas"&gt;after&lt;/font&gt;&lt;/b&gt; after &amp;#96;write_version_hash(after,&lt;br&gt;last_sealed)&amp;#96;&lt;br&gt;the xslt only finished wizard copies: the hash is&lt;br&gt;refreshed' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="60" y="560" width="330" height="78" as="geometry"/></mxCell>
        <mxCell id="c27" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="c9" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c28" value='&lt;b&gt;return &lt;font face="Consolas"&gt;after&lt;/font&gt;&lt;/b&gt;&lt;br&gt;only formatting changed: the sealed text is back,&lt;br&gt;the log says &lt;font face="Consolas"&gt;restored the sealed text&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=center;verticalAlign=middle;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="60" y="900" width="330" height="78" as="geometry"/></mxCell>
        <mxCell id="c29" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0" edge="1" parent="1" source="c11" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c30" value='After the seal, &lt;font face="Consolas"&gt;cpp2cpp_after_xslt&lt;/font&gt; runs &lt;font face="Consolas"&gt;validate_language&lt;/font&gt;&lt;br&gt;again.&lt;br&gt;&lt;br&gt;&lt;b&gt;A user xslt never rewrites a hash.&lt;/b&gt; The language is checked as&lt;br&gt;it is. &lt;font face="Consolas"&gt;force&lt;/font&gt; does not apply in this run.' style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1160" y="320" width="400" height="85" as="geometry"/></mxCell>
        <mxCell id="c31" value='What the user sees: an xslt may "edit" an old version, and the&lt;br&gt;edit shows up in the &lt;b&gt;next open version&lt;/b&gt;, while the old text&lt;br&gt;stays as it was.' style="whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1160" y="520" width="400" height="55" as="geometry"/></mxCell>
        <mxCell id="c32" value="Cost: the seal compiles &lt;b&gt;both&lt;/b&gt; graphs, which is the most&lt;br&gt;expensive part of the step on a large project." style="whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1160" y="660" width="400" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
