<mxfile host="app.diagrams.net">
  <diagram name="35_dev_run_construction" id="35_dev_run_construction">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value='How &lt;font face="Consolas"&gt;translate_by_config&lt;/font&gt; builds a run' style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;strokeWidth=1;fontSize=20;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=0;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=0;fontStyle=1;strokeColor=none;fillColor=none" vertex="1" parent="1"><mxGeometry x="30" y="16" width="1500" height="31" as="geometry"/></mxCell>
        <mxCell id="c3" value='&lt;b&gt;1 filesystem&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;physically::make_filesystem()&lt;/font&gt;&lt;br&gt;&lt;font face="Consolas"&gt;filesystem_decorator_t fsd&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="90" width="290" height="140" as="geometry"/></mxCell>
        <mxCell id="c4" value='&lt;b&gt;2 mode&lt;/b&gt;&lt;br&gt;&lt;font face="Consolas"&gt;input-gal-dir == output-gal-dir&lt;/font&gt;?&lt;br&gt;normal: one .gal place&lt;br&gt;separate: two' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="350" y="90" width="290" height="140" as="geometry"/></mxCell>
        <mxCell id="c5" value='&lt;b&gt;3 places&lt;/b&gt;&lt;br&gt;.gal, intermediate xml,&lt;br&gt;one per &lt;font face="Consolas"&gt;other-files&lt;/font&gt; store&lt;br&gt;(alias unique per transform)' style="whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="670" y="90" width="290" height="140" as="geometry"/></mxCell>
        <mxCell id="c6" value='&lt;b&gt;4 summary&lt;/b&gt;&lt;br&gt;builder + scope guard:&lt;br&gt;always writes&lt;br&gt;&lt;font face="Consolas"&gt;galimatron_summary.xml&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="990" y="90" width="290" height="140" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;5 process_result&lt;/b&gt;&lt;br&gt;the callback for each step:&lt;br&gt;routes xml and files to places,&lt;br&gt;adds a summary entry" style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1310" y="90" width="290" height="140" as="geometry"/></mxCell>
        <mxCell id="c8" value='&lt;b&gt;6 the job&lt;/b&gt;&lt;br&gt;inner &lt;font face="Consolas"&gt;try_catch&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1630" y="90" width="290" height="140" as="geometry"/></mxCell>
        <mxCell id="c9" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c10" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c11" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c12" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c13" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c14" value='&lt;b&gt;6.1&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;fsd.do_jobs_at_begin()&lt;/font&gt;&lt;br&gt;create folders, delete the files of &lt;font face="Consolas"&gt;at_begin&lt;/font&gt;&lt;br&gt;places' style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="330" width="290" height="120" as="geometry"/></mxCell>
        <mxCell id="c15" value='&lt;b&gt;6.2&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;crash::arm_summary(path)&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="350" y="330" width="290" height="120" as="geometry"/></mxCell>
        <mxCell id="c16" value='&lt;b&gt;6.3&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;add_directory_parameters&lt;/font&gt;&lt;br&gt;six &lt;font face="Consolas"&gt;xsl:param&lt;/font&gt;s to each enabled user transform&lt;br&gt;(on a copy)' style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="670" y="330" width="290" height="120" as="geometry"/></mxCell>
        <mxCell id="c17" value='&lt;b&gt;6.4&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;translator::translate({...})&lt;/font&gt;&lt;br&gt;callbacks: notify result, taskflow graph,&lt;br&gt;state memory' style="whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="990" y="330" width="290" height="120" as="geometry"/></mxCell>
        <mxCell id="c18" value='&lt;b&gt;6.5&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;summary.set_result(true)&lt;/font&gt;' style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1310" y="330" width="290" height="120" as="geometry"/></mxCell>
        <mxCell id="c19" value='&lt;b&gt;6.6&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font face="Consolas"&gt;fsd.do_jobs_at_end()&lt;/font&gt;&lt;br&gt;write delayed .gal, remove stale files' style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1;fontSize=11;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="1630" y="330" width="290" height="120" as="geometry"/></mxCell>
        <mxCell id="c20" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c21" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c22" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c23" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c24" value="" style="html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=1;strokeColor=#555555;strokeWidth=1.5;endArrow=block;endFill=1;startArrow=none;fontSize=10;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="c8" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c26" value='&lt;b&gt;on an error&lt;/b&gt; step 6.5 and 6.6 do not run. The inner catch copies the error text into the summary, the guard of step 4 writes the summary with &lt;font face="Consolas"&gt;status="fail"&lt;/font&gt;, the outer catch logs the text, the exit code is 1.&lt;br&gt;&lt;b&gt;on success&lt;/b&gt; the summary says &lt;font face="Consolas"&gt;success&lt;/font&gt;, the delayed &lt;font face="Consolas"&gt;.gal&lt;/font&gt; files are written (only if their text changed), and stale files of &lt;font face="Consolas"&gt;delete-if-not-rewrited&lt;/font&gt; stores are removed.' style="whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1;fontSize=12;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;spacingTop=2;spacingBottom=2;rounded=1;arcSize=8" vertex="1" parent="1"><mxGeometry x="30" y="520" width="1900" height="84" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
