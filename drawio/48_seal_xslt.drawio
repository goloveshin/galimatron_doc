        <mxCell id="t" value="One xslt edits the whole description, closed versions too" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=14;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="20" y="0" width="780" height="26" as="geometry"/>
        </mxCell>
        <mxCell id="lh" value="before the xslt" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="36" width="240" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="rh" value="after the xslt, before the seal" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="36" width="300" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="b0" value="protocol, version 0" style="swimlane;whiteSpace=wrap;html=1;rounded=1;arcSize=8;startSize=26;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="20" y="64" width="270" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="b0b" value="&lt;span style=&quot;font-family:Helvetica;font-size:12px;color:#444444;&quot;&gt;closed (has a hash)&lt;/span&gt;&lt;br&gt;label role_mark = static { role };&lt;br&gt;roles = role_mark { [ &amp;quot;user&amp;quot; ] };" style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=6;fontFamily=Courier New;fontSize=12;" vertex="1" parent="b0">
