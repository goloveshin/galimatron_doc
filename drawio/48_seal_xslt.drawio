  <diagram name="48_seal_xslt" id="48_seal_xslt">
    <mxGraphModel dx="900" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="910" pageHeight="370" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
