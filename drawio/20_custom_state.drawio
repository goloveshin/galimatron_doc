        <mxCell id="a2" value="reads" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;edgeStyle=none;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="st" target="r2">
