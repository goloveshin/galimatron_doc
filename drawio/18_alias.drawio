<mxfile host="app.diagrams.net">
  <diagram name="18_alias" id="18_alias">
    <mxGraphModel dx="900" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="400" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="x" value="in your xslt:&lt;br&gt;&amp;lt;xsl:result-document&lt;br&gt;&amp;nbsp;&amp;nbsp;href=&quot;@@&lt;span style=&quot;background-color:#ffb066;border-radius:3px;&quot;&gt;generated-sql&lt;/span&gt;@@&lt;span style=&quot;background-color:#9fd96b;border-radius:3px;&quot;&gt;v6/schema.sql&lt;/span&gt;@@&quot;&amp;gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Courier New;fontSize=15;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="440" height="92" as="geometry"/>
        </mxCell>
        <mxCell id="c" value="in gal.cfg:&lt;br&gt;&quot;store-dir&quot; : &quot;&lt;span style=&quot;background-color:#f5a3d2;border-radius:3px;&quot;&gt;generated_sql/&lt;/span&gt;&quot;,&lt;br&gt;&quot;store-dir-string-alias&quot; : &quot;&lt;span style=&quot;background-color:#ffb066;border-radius:3px;&quot;&gt;generated-sql&lt;/span&gt;&quot;,&lt;br&gt;&quot;extentions&quot; : [&quot;.sql&quot;]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Courier New;fontSize=15;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="30" y="160" width="440" height="112" as="geometry"/>
        </mxCell>
        <mxCell id="f" value="&lt;span style=&quot;background-color:#f5a3d2;border-radius:3px;&quot;&gt;generated_sql/&lt;/span&gt;&lt;span style=&quot;background-color:#9fd96b;border-radius:3px;&quot;&gt;v6/schema.sql&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Courier New;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="30" y="320" width="440" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="a1" value="alias" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;edgeStyle=none;fontSize=13;" edge="1" parent="1" source="x" target="c">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="a2" value="folder + relative path" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;edgeStyle=none;fontSize=13;" edge="1" parent="1" source="c" target="f">
          <mxGeometry relative="1" as="geometry"></mxGeometry>
        </mxCell>
        <mxCell id="n" value="The name between the first two @@ is the &lt;span style=&quot;background-color:#ffb066;border-radius:3px;&quot;&gt;alias&lt;/span&gt;. Galimatron swaps it for the &lt;span style=&quot;background-color:#f5a3d2;border-radius:3px;&quot;&gt;folder&lt;/span&gt; that gal.cfg gives that alias, and puts the &lt;span style=&quot;background-color:#9fd96b;border-radius:3px;&quot;&gt;relative path&lt;/span&gt; after it. The XSLT never holds a path. A file with an extension that is not listed is refused." style="text;html=1;whiteSpace=wrap;verticalAlign=middle;align=left;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="510" y="20" width="290" height="350" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
